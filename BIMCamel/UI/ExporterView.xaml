<UserControl x:Class="BIMCamel.UI.ExporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             ToolTipService.ShowDuration="20000" ToolTipService.InitialShowDelay="350"
             FontFamily="Segoe UI" FontSize="13">

  <UserControl.Resources>
    <!-- ════ Palette (light defaults; swapped at runtime for dark) ════ -->
    <SolidColorBrush x:Key="Accent"      Color="#0070C0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0D83DA"/>
    <SolidColorBrush x:Key="AccentPress" Color="#005A9C"/>
    <SolidColorBrush x:Key="Bg"          Color="#EEF1F5"/>
    <SolidColorBrush x:Key="Pane"        Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Card"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Card2"       Color="#FBFCFD"/>
    <SolidColorBrush x:Key="Text"        Color="#1F2329"/>
    <SolidColorBrush x:Key="Muted"       Color="#6B7480"/>
    <SolidColorBrush x:Key="Faint"       Color="#9AA3AD"/>
    <SolidColorBrush x:Key="Bd"          Color="#E1E5EA"/>
    <SolidColorBrush x:Key="BdStrong"    Color="#CDD3DA"/>
    <SolidColorBrush x:Key="Field"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBd"     Color="#CDD3DA"/>
    <SolidColorBrush x:Key="Nav"         Color="#F0F2F5"/>
    <SolidColorBrush x:Key="NavActive"   Color="#E6F0FA"/>
    <SolidColorBrush x:Key="AmberBg"     Color="#FFF7E6"/>
    <SolidColorBrush x:Key="AmberBd"     Color="#FFE1A8"/>
    <SolidColorBrush x:Key="AmberTx"     Color="#8A5A00"/>
    <SolidColorBrush x:Key="ConsoleBg"   Color="#0E1116"/>
    <SolidColorBrush x:Key="ConsoleTx"   Color="#CFE3D5"/>
    <SolidColorBrush x:Key="Ok"          Color="#1A8F4C"/>
    <SolidColorBrush x:Key="BadgeReqBg"  Color="#E4F6EC"/>
    <SolidColorBrush x:Key="BadgeReqTx"  Color="#1A8F4C"/>
    <SolidColorBrush x:Key="BadgeOptBg"  Color="#ECEFF3"/>
    <SolidColorBrush x:Key="BadgeOptTx"  Color="#6B7480"/>
    <SolidColorBrush x:Key="BadgeAutoBg" Color="#E6F0FA"/>
    <SolidColorBrush x:Key="BadgeAutoTx" Color="#0070C0"/>

    <!-- ════ Text styles ════ -->
    <Style x:Key="H3" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="LineHeight" Value="16"/>
    </Style>

    <!-- required / optional badges (shown on each section header) -->
    <Style x:Key="BadgeReq" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BadgeReqBg}"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="7,1"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeOpt" TargetType="Border" BasedOn="{StaticResource BadgeReq}">
      <Setter Property="Background" Value="{DynamicResource BadgeOptBg}"/>
    </Style>
    <!-- Marks a section that Smart setup fills automatically (and that stays
         hand-editable). The three chips together answer the three questions a
         tab has to answer at a glance: required? optional? automatic? -->
    <Style x:Key="BadgeAuto" TargetType="Border" BasedOn="{StaticResource BadgeReq}">
      <Setter Property="Background" Value="{DynamicResource BadgeAutoBg}"/>
    </Style>

    <!-- ════ Card ════ -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ════ TextBox ════ -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <!-- The same 34 px as a ComboBox, so a text box and a drop-down side by side line up.
           The padding is horizontal only: vertical padding on a fixed-height box is what
           squeezed the grid cells' text area down to nothing. -->
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBd}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A field inside a grid row or a rule card: 28 px, like the drop-downs next to it. -->
    <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- A number inside a sentence ("Skip geometry smaller than [5] mm"): no taller than the
         check box it follows. -->
    <Style x:Key="InlineNum" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Margin" Value="8,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- One rule = one card: rules have 4-6 fields, which a grid row squeezed
         into unreadable slivers at docked-pane widths. -->
    <Style x:Key="RuleCard" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="rb" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="9" Padding="8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="rb" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="rb" Property="Background" Value="{DynamicResource NavActive}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pop-up menus built in code (profile menu, + Token, chip menu). Code merges this
         dictionary into each menu, so the theme brushes resolve inside the pop-up too. -->
    <Style x:Key="PaneMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,6">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaneMenuSep" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource Bd}"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaneMenu" TargetType="ContextMenu">
      <Setter Property="ItemContainerStyle" Value="{StaticResource PaneMenuItem}"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Margin="0,2,10,12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource BdStrong}" BorderThickness="1"
                    CornerRadius="9" Padding="4">
              <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.16"/></Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- File name editor: a token chip and the plain text between chips. -->
    <Style x:Key="NameChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BadgeAutoBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BadgeAutoTx}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,2,2,2"/>
      <Setter Property="Margin" Value="1,2"/>
      <Setter Property="Cursor" Value="SizeAll"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NameText" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="1,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Secondary button ════ -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource FieldBd}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Link-style button ════ -->
    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock Text="{TemplateBinding Content}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Link-style toggle (show / hide a detail block) ════ -->
    <Style x:Key="LinkToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <TextBlock Background="Transparent" Text="{TemplateBinding Content}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Primary export button ════ -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="12">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#0070C0" Offset="0"/>
                  <GradientStop Color="#0D83DA" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.93"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ CheckBox ════ -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,5,0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <!-- A grid, not a horizontal stack: a stack gives the label infinite width, so a long
                 one ran off the card instead of wrapping. -->
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="17" Height="17" CornerRadius="5" BorderThickness="2"
                      BorderBrush="{DynamicResource BdStrong}" Background="Transparent" VerticalAlignment="Top" Margin="0,0,0,0">
                <Path x:Name="tick" Data="M2,6 L5,9 L10,3" Stroke="White" StrokeThickness="2"
                      Stretch="None" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ RadioButton as a "scope option" card ════ -->
    <Style x:Key="OptionCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" BorderBrush="{DynamicResource FieldBd}" BorderThickness="1" CornerRadius="9"
                    Padding="10,9" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <Grid Width="15" Height="15" VerticalAlignment="Center">
                  <Ellipse x:Name="ring" Stroke="{DynamicResource BdStrong}" StrokeThickness="2"/>
                  <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/>
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ ComboBox (flat, rounded) ════ -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0,8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBd}"
                            BorderThickness="1" CornerRadius="8" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <!-- The typed text sits exactly where the picked text does: same padding, and the
                   arrow's column kept clear. -->
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PART_EditableTextBox" MinHeight="0" Padding="0" VerticalAlignment="Center"
                         Background="Transparent" Foreground="{DynamicResource Text}" Visibility="Hidden">
                  <TextBox.Template>
                    <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate>
                  </TextBox.Template>
                </TextBox>
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                        CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,4,0,0" SnapsToDevicePixels="True">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
                  <ScrollViewer MaxHeight="240"><StackPanel IsItemsHost="True" Margin="0,4"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="7,0,6,0"/>
    </Style>

    <!-- ════ Slim scroll bar ════ -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border CornerRadius="3" Background="{DynamicResource BdStrong}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
              <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                  <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ════ ProgressBar ════ -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{DynamicResource Bd}" CornerRadius="4" ClipToBounds="True">
              <Grid>
                <Border x:Name="PART_Track"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#0070C0" Offset="0"/><GradientStop Color="#0D83DA" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Title-bar icon button ════ -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="#29FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#47FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Top tabs ════ -->
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource Nav}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1" Padding="8,5">
                <UniformGrid Rows="1" IsItemsHost="True"/>
              </Border>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource Text}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="8" Padding="4,6" Cursor="Hand">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0F000000"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Bd}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Card2}"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="6,7"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <!-- ════════════════════ LAYOUT ════════════════════ -->
  <Border Background="{DynamicResource Pane}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar: a slim strip, so the settings get the height. The white mark and the
           wordmark read as one logo, with the tool's name beside it. -->
      <Border Grid.Row="0" Height="38">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0070C0" Offset="0"/><GradientStop Color="#0D83DA" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="10,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- BIMCamel wordmark, from the website's logo-text.svg (viewBox 0 0 520 120),
                 cropped to the drawn area and filled white for the blue bar. -->
            <Viewbox x:Name="LogoMark" Height="19" Stretch="Uniform" VerticalAlignment="Center" ToolTip="BIMCamel">
              <Canvas Width="472" Height="76">
                <Canvas Canvas.Left="-24" Canvas.Top="-16">
                  <Path Fill="White" Data="F0 M72,76l-4,0l0,-4l4,0l0,4Zm24,-4l4,0l0,4l-4,0l0,-4Zm-48,0l0,20l-8,0l0,-4l4,0l0,-16l4,0Zm-4,0l-4,0l0,-4l4,0l0,4Zm48,-8l4,0l0,8l-4,0l0,-8Zm-16,12l0,16l-8,0l0,-4l4,0l0,-12l4,0Zm16,-12l-8,0l0,28l-4,0l0,-16l-4,0l0,-8l-20,0l0,24l-4,0l0,-20l-4,0l0,-8l-12,0l0,-4l-4,0l0,-12l4,0l0,-16l-4,0l0,4l-8,0l0,-12l4,0l0,-4l8,0l0,-4l4,0l0,4l4,0l0,-4l4,0l0,16l-4,0l0,12l8,0l0,-4l4,0l0,-4l4,0l0,-4l20,0l0,4l4,0l0,4l4,0l0,4l4,0l0,20Zm-12,-16l-4,0l0,4l-8,0l0,4l8,0l0,-4l4,0l0,-4Z"/>
                  <Path Fill="White" Data="F1 M152,92l-36,0l0,-60l36,-0l0,12l12,0l0,8l-12,0l0,-8l-24,0l0,8l24,0l0,12l12,0l0,16l-12,0l0,-16l-24,0l0,16l24,0l0,12Z M192,91.913l-24,0.087l0,-12l8,0l0,-36l-8,0l0,-12l24,-0l0,12l-4,0l0,36l4,0l-0,11.913Z M252,92l-12,0l0,-40l-8,0l0,12l-12,0l0,-12l12,0l0,-8l8,0l0,-12l12,0l0,60Zm-43.714,-0.087l-12.286,0.087l0,-60l12,0l0,12l12,0l0,8l-12,0l0.286,39.913Z M308,92l-40,-0.087l0,-11.913l32,-0l0,-12l12,0l0,12l-4,0l0,12Zm-40,-12l-12,0l0,-36l12,-0l0,36Zm44,-28l-12,0l0,-8l-32,0l-0,-11.801l40,-0.199l0,12l4,0l0,8Z M360.286,91.913l-32.571,0l0.286,-11.913l-12,0l0,-12l12,-0l0,-4l20,0l0,-12l12,0l0.286,39.913Zm-32.286,-11.913l20,0l0,-12l-20,0l0,12Zm20,-28l-32,0l0,-8l32,0l0,8Z M436,92l-12,0l0,-32l12,0l0,32Zm-28,0l-4.286,-0.087l-7.714,0.087l0,-32l12,0l0,32Zm-32,0l-12,0l0,-44l32,0l-0,12l-20,0l0,32Zm48,-32l-16,0l0,-12l16,0l0,12Z M480,92l-28,0l0,-12l16,-0l0,-4l12,0l0,16Zm-28,-12l-12,0l0,-20l12,0l0,-12l28,0l0,16l-12,0l0,4l-16,0l0,12Zm0,-16l16,0l0,-4l-16,0l0,4Z M484,32l12,0l0,60l-12,0Z"/>
                </Canvas>
              </Canvas>
            </Viewbox>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="LblSubtitle" Text="IFC Exporter" Foreground="#E6FFFFFF" FontSize="12.5" Margin="9,3,8,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip="The profile these settings came from. A dot means they were changed after it was loaded."/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <!-- Profiles live in the title bar: they capture the WHOLE pane, so
                 parking them inside one tab's card suggested a narrower reach
                 than they actually have. -->
            <Button x:Name="BtnSaveProfile" Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="OnSaveProfile"
                    ToolTip="Save the export settings — schema, scope, options, coordinates, roles, parameter rules and the set mapping — to a reusable .json profile. (List ticks and the theme are not stored.)"><Viewbox Width="15" Height="15"><Path x:Name="IcoSave" Data="M5,3 L16,3 L21,8 L21,21 L3,21 L3,3 Z M7,3 L7,9 L15,9 L15,3 M7,21 L7,14 L17,14 L17,21" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button>
            <!-- One menu for every way of replacing the current settings: a saved
                 profile, a built-in preset, or the defaults. Settings themselves are
                 remembered between sessions, so a profile is for sharing, not for
                 surviving a restart. -->
            <Button x:Name="BtnLoadProfile" Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="OnProfileMenu"
                    ToolTip="Load a saved profile, apply a built-in preset, or reset everything to defaults."><Viewbox Width="15" Height="15"><Path x:Name="IcoProfiles" Data="M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button>
            <Button x:Name="BtnTheme" Style="{StaticResource IconBtn}" ToolTip="Switch between light and dark theme" Click="OnToggleTheme"><Viewbox Width="15" Height="15"><Path x:Name="IcoTheme" Data="M20,14 A8,8 0 1 1 10,4 A6,6 0 0 0 20,14 Z" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Tabs + content -->
      <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <!-- ===== EXPORT ===== -->
        <TabItem x:Name="TabExport">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="Core export settings: schema, units, scope and output">
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Data="M12,3 L12,15 M8,11 L12,15 L16,11 M4,17 L4,19 A2,2 0 0 0 6,21 L18,21 A2,2 0 0 0 20,19 L20,17" StrokeThickness="2"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </Viewbox>
              <TextBlock Text="Export" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,8">
            <StackPanel>
              <!-- DataTools warning (dismissible) -->
              <Border x:Name="WarnBanner" CornerRadius="10" Padding="11,9,8,9" Margin="0,0,0,12"
                      Background="{DynamicResource AmberBg}" BorderBrush="{DynamicResource AmberBd}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="{DynamicResource AmberTx}" Margin="0,0,9,0" VerticalAlignment="Top"/>
                  <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource AmberTx}"
                             Text="Before exporting, deactivate any DataTools / external-database links (Home → DataTools). They run a query per object and drastically slow export."/>
                  <Button Grid.Column="2" Content="✕" Click="OnDismissWarning" ToolTip="Dismiss this notice" Cursor="Hand"
                          VerticalAlignment="Top" Foreground="{DynamicResource AmberTx}" FontSize="11" Margin="6,-2,0,0">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Width="20" Height="20" CornerRadius="5" Background="Transparent">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="#22000000"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Border>

              <!-- Top to bottom the tab now reads choose → scan → check → export:
                   scope first (Smart setup and Pre-flight both read it), then the
                   handful of format choices most exports touch, then the scan.
                   Everything that only tunes size, speed or diagnostics lives in
                   the collapsed Advanced card below. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="WHAT TO EXPORT"/>
                    <Border Style="{StaticResource BadgeReq}"><TextBlock Text="REQUIRED" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeReqTx}"/></Border>
                  </StackPanel>
                  <StackPanel x:Name="ScopeOptions"/>
                  <TextBlock x:Name="LblScopeHint" Style="{StaticResource Hint}" Foreground="{DynamicResource AmberTx}"/>
                  <StackPanel x:Name="SavedSetRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Lbl}" Text="Saved set"/>
                    <ComboBox x:Name="CmbSavedSet" ToolTip="The saved selection/search set to export."/>
                  </StackPanel>
                  <StackPanel x:Name="BatchRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Lbl}" Text="Sets to export (one IFC each)"/>
                    <Border BorderBrush="{DynamicResource FieldBd}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource Field}" Padding="4" MaxHeight="150"
                            ToolTip="Tick the sets to export; each becomes its own IFC file.">
                      <ListBox x:Name="LstBatch" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem"><Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                          </Setter.Value></Setter></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Checked, Mode=TwoWay}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Border>
                    <WrapPanel Margin="0,7,0,0">
                      <!-- The list refreshes itself whenever this scope is chosen;
                           the old Refresh button duplicated that. -->
                      <Button Style="{StaticResource Btn}" Content="All" Click="OnBatchAll" ToolTip="Tick all sets."/>
                      <Button Style="{StaticResource Btn}" Content="None" Click="OnBatchNone" ToolTip="Untick all sets. The list itself reloads each time this scope is selected."/>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- The four choices nearly every export makes. Base point and
                   georeferencing stay on the Coordinates tab — they are about WHERE
                   the model sits, not about the file. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="FORMAT"/>
                    <Border Style="{StaticResource BadgeReq}"><TextBlock Text="REQUIRED" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeReqTx}"/></Border>
                  </StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Style="{StaticResource Lbl}" Text="IFC schema"/>
                      <ComboBox x:Name="CmbSchema" ToolTip="IFC version to write. IFC4 is recommended; choose IFC2x3 only if the receiving software requires it."/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                      <TextBlock Style="{StaticResource Lbl}" Text="Source units"/>
                      <ComboBox x:Name="CmbUnits" ToolTip="Length unit of the source model. 'Auto' reads it from the model — only override if the model's units are wrong."/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                      <TextBlock Style="{StaticResource Lbl}" Text="Geometry quality"/>
                      <ComboBox x:Name="CmbQuality" ToolTip="Vertex welding tolerance and stored coordinate precision. 'Balanced' suits most models; 'Small file' welds more coarsely, 'High detail' preserves finer detail and writes larger files. Navisworks fixes the mesh tessellation when the NWC is made, so this cannot add detail that is not already there."/>
                    </StackPanel>
                  </Grid>
                  <CheckBox x:Name="ChkZip" Margin="0,11,0,0" Content="Write compressed .ifczip (recommended)" ToolTip="Write IFC's standard zipped form: an ordinary ZIP holding one .ifc, read directly by Revit, Solibri, ArchiCAD, Navisworks, xBim and IfcOpenShell with no unpacking step.&#x0a;&#x0a;STEP text compresses very well, so this is typically 6-12x smaller on disk. It also writes LESS data: the export streams straight into the archive, so the uncompressed file is never created at all.&#x0a;&#x0a;Turn it off if a downstream script expects a literal .ifc."/>
                  <TextBlock Style="{StaticResource Lbl}" Text="File name" Margin="0,9,0,5"/>
                  <!-- The template string itself, which profiles store. The editor below is built
                       from it and writes back to it; nobody types tokens by hand any more. -->
                  <TextBox x:Name="TxtFileName" Text="{}{model}_{schema}" Visibility="Collapsed"/>
                  <Border x:Name="NameEditor" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBd}" BorderThickness="1"
                          CornerRadius="8" Padding="4,3,3,3" MinHeight="34" AllowDrop="True"
                          ToolTip="The exported file's name. Blue chips are filled in at export; type plain text between them. Drag a chip to move it, × or right-click to remove it.">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <WrapPanel x:Name="NameChips" VerticalAlignment="Center" Background="Transparent"/>
                      <Button x:Name="BtnAddToken" Grid.Column="1" Style="{StaticResource Btn}" Margin="4,0,0,0" Padding="8,3" VerticalAlignment="Center"
                              Content="+ Token" Click="OnAddToken" ToolTip="Insert a value that is filled in at export: model, set, selected element, date…"/>
                    </Grid>
                  </Border>
                  <TextBlock x:Name="LblNamePreview" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
              </Border>

              <!-- One button for every auto-detect the pane has. These used to be
                   five buttons on three tabs (Detect from model, Scan model,
                   Auto-map, Refresh sets ×2) that partly called the same code —
                   nobody could tell what ran what. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource H3}" Text="SMART SETUP"/>
                    <Border Style="{StaticResource BadgeAuto}"><TextBlock Text="AUTO" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeAutoTx}"/></Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,9"
                             Text="One scan of the scope above prepares the whole export: finds your saved sets, samples property sets, fills the semantic roles (Data tab), proposes set→class rules (Mapping tab), and fills the pre-flight checks below. Anything you already set by hand is left alone."/>
                  <Button Style="{StaticResource Btn}" Margin="0" Content="Smart setup: scan &amp; auto-fill" Click="OnSmartSetup" HorizontalAlignment="Left"
                          ToolTip="Runs every auto-detect in sequence over the scope selected above. Takes roughly as long as collecting that scope once (geometry is not read); use Stop by the progress bar to interrupt it. Re-running only fills blanks — it never overwrites your entries. One nuance: a role or rule you deliberately blanked counts as blank, so it will be proposed again."/>
                  <TextBlock x:Name="TxtSmartSummary" FontFamily="Consolas" Text="">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                        <Setter Property="Margin" Value="0,8,0,0"/>
                        <Style.Triggers>
                          <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>

              <!-- The trust surface: everything worth knowing about the output
                   BEFORE the Export button is pressed, as ✓/⚠ rows. Cheap facts
                   (schema, units, georef, per-model origins) render live; facts
                   that need a scan fill in after Smart setup or Preview, and are
                   marked stale when settings change under them. Informational
                   only — it never blocks the quick one-click export. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource H3}" Text="PRE-FLIGHT"/>
                  </StackPanel>
                  <TextBlock x:Name="LblPreflightWhen" Style="{StaticResource Hint}" Margin="0,0,0,7"
                             Text="Checks that need a scan fill in after Smart setup or Run full check."/>
                  <StackPanel x:Name="PreflightHost"/>
                  <!-- The mapping preview used to live on the Mapping tab with its own
                       console, while the rows it fills lived here: checking meant two
                       places. Now it runs here, and its full breakdown folds out below. -->
                  <WrapPanel Margin="0,9,0,0">
                    <Button Style="{StaticResource Btn}" Content="Run full check" Click="OnPreviewMapping"
                            ToolTip="Resolve the mapping rules and roles against the scope above, without writing anything: how many elements map, to which classes, how many fall back to proxy, property coverage and geometry size. Takes about as long as collecting the scope once."/>
                    <ToggleButton x:Name="TglCheckDetails" Style="{StaticResource LinkToggle}" Content="Show details" VerticalAlignment="Center" Margin="4,0,0,0"
                                  ToolTip="Show the full breakdown from the last check."/>
                  </WrapPanel>
                  <Border x:Name="CheckDetails" Background="{DynamicResource ConsoleBg}" CornerRadius="9" Padding="11" Margin="0,8,0,0" MaxHeight="220" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtPreview" Foreground="{DynamicResource ConsoleTx}" FontFamily="Consolas"
                                 FontSize="11" TextWrapping="NoWrap" Text="Run full check to see how many elements map, and how many will export as IfcBuildingElementProxy."/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Size, speed and diagnostics. Collapsed by default because the
                   defaults are right for most exports; the header counts settings
                   that differ from those defaults, so a loaded profile can never
                   hide a change behind the fold. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <ToggleButton x:Name="TglAdvanced" Cursor="Hand" Focusable="True"
                                ToolTip="Show or hide the size, speed and diagnostics options.">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H3}" Text="ADVANCED OPTIONS"/>
                            <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AmberTx}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                          <TextBlock Grid.Column="2" x:Name="chev" Text="▸" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="Text" Value="▾"/></Trigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chev" Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>

                  <StackPanel x:Name="AdvancedBody" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Lbl}" Text="File size &amp; speed" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <CheckBox x:Name="ChkInstancing" Content="Optimize repeated geometry (instancing)" ToolTip="Reuse identical geometry across elements to shrink the file and speed up export."/>
                    <CheckBox x:Name="ChkMergeParts" Margin="26,3,0,3" Content="Merge multi-part elements (element-level instancing)" ToolTip="An element built from many fragments (a seat of a thousand parts) is written as ONE shape instead of one placed copy per fragment, and every identical element reuses that shape. Viewers then place one copy per element, not millions of tiny ones.&#x0a;&#x0a;Applies to elements with more than 16 parts. Elements with fewer keep per-part instancing.&#x0a;&#x0a;Needs instancing to be on."/>
                    <CheckBox x:Name="ChkFastInstancing" Margin="26,3,0,5" Content="Fast instancing — trust type + size (experimental)" ToolTip="Skip re-reading the geometry of elements that look like a repeat of one already read (same tree type, size, fragment count and colour). Reading triangles is 80-90% of the export, and most models repeat their shapes many times, so this can be several times faster.&#x0a;&#x0a;It is a GUESS about the model, so it checks itself: every 20th repeat is read for real and compared. Any disagreement is reported, that shape is dropped, and the file stays correct. Turn this on only after a run reports zero mismatches on YOUR model.&#x0a;&#x0a;Needs instancing to be on."/>
                    <CheckBox x:Name="ChkSkipEmptyProps" Content="Skip empty property values" ToolTip="Do not write properties whose value is blank. Each one costs a full entity carrying a single space, and blanks also stop otherwise-identical property sets from being shared."/>
                    <CheckBox x:Name="ChkShareTypeProps" Content="Share type-level properties (IFC4, needs a Type role)" ToolTip="Put the properties that are the same for every element of a type onto the IfcElementType, and write only what differs on each element - the standard IFC arrangement (type Psets shared, occurrence Psets override).&#x0a;&#x0a;This is the biggest remaining saving for property-heavy models, because a set with one per-element value (an Id or Mark) currently forces ALL its properties to be repeated per element.&#x0a;&#x0a;Off by default because it moves data to where a simpler IFC reader may not look. The report says how many elements it could not express exactly - zero means the export is faithful."/>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="ChkMinSize" Content="Skip geometry smaller than" VerticalAlignment="Center" ToolTip="Leave out parts below this size - washers, fasteners, screen-only detail. These are a large share of the triangle count on plant models and add nothing to a coordination deliverable.&#x0a;&#x0a;This REMOVES objects rather than simplifying them, so everything dropped is counted in the report."/>
                      <TextBox x:Name="TxtMinSizeMm" Text="5" Style="{StaticResource InlineNum}"/>
                      <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="ChkSimplify" Content="Simplify meshes within" VerticalAlignment="Center" ToolTip="Reduce heavily tessellated objects before they are written: triangles are removed from flat and gently curved regions while no surface moves further than this distance. Each unique shape is simplified once and every copy of it reuses the result.&#x0a;&#x0a;Unlike 'Skip geometry smaller than' nothing is left out - every object is still there, with fewer triangles. Off by default because it changes the shapes; the report gives the triangle count before and after."/>
                      <TextBox x:Name="TxtSimplifyMm" Text="10" Style="{StaticResource InlineNum}"/>
                      <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                ToolTip="Split the output into multiple files once it grows past this size.">
                      <CheckBox x:Name="ChkSplit" Content="Split into files larger than" VerticalAlignment="Center"/>
                      <TextBox x:Name="TxtSplitMb" Text="200" Style="{StaticResource InlineNum}"/>
                      <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Lbl}" Text="Checks &amp; diagnostics" FontWeight="SemiBold" Margin="0,12,0,2"/>
                    <CheckBox x:Name="ChkValidate" Content="Validate output after export" ToolTip="Check the written IFC for structural damage and for the mistakes this exporter can make — bad PredefinedType values, wrong attribute counts, dangling references."/>
                    <CheckBox x:Name="ChkProfile" Content="Size &amp; time breakdown in report (adds a little time)" ToolTip="Break down where the file size and the export time went, in the report below. Adds a little overhead."/>

                    <Button Style="{StaticResource LinkBtn}" Content="↺ Reset advanced options to defaults" Click="OnResetAdvanced" Margin="0,8,0,0"
                            ToolTip="Put every option in this card back to its default. Scope, format and the other tabs are not touched."/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock x:Name="LblReportHead" Style="{StaticResource H3}" Text="REPORT" Margin="0,0,0,10"/>
                  <Border CornerRadius="9" Background="{DynamicResource ConsoleBg}" Padding="11" MaxHeight="190">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtReport" Foreground="{DynamicResource ConsoleTx}" FontFamily="Consolas"
                                 FontSize="11" TextWrapping="NoWrap" Text="Configure and click Export IFC."/>
                    </ScrollViewer>
                  </Border>
                  <!-- The output stays one click away after the export, instead of a
                       modal "Open now?" that was gone once answered. -->
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="BtnOpenFile" Style="{StaticResource Btn}" Content="Open file" Click="OnOpenOutput" IsEnabled="False"
                            ToolTip="Open the exported IFC in its default viewer."/>
                    <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn}" Content="Open folder" Click="OnOpenOutputFolder" IsEnabled="False"
                            ToolTip="Show the exported file(s) in Explorer."/>
                    <Button Style="{StaticResource Btn}" Content="Save report…" Click="OnSaveReport"
                            ToolTip="Save this report as a text file, to keep a record of the export."/>
                    <Button Style="{StaticResource Btn}" Content="Copy" Click="OnCopyReport" ToolTip="Copy the report text to the clipboard."/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ===== DATA (was Properties + Semantics) ===== -->
        <TabItem x:Name="TabData">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="What data each element carries: property sets, materials, quantities, semantic roles and parameter renames. All optional — Smart setup fills the marked sections.">
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18" StrokeThickness="2"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </Viewbox>
              <!-- The dot appears when pre-flight has a warning this tab fixes. -->
              <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="Data" FontSize="12"/>
                <Ellipse x:Name="DotData" Width="6" Height="6" Fill="{DynamicResource AmberTx}" Visibility="Collapsed"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-8,0"/>
              </Grid>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,8">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="WHAT TO EXPORT"/>
                    <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                  </StackPanel>
                  <CheckBox x:Name="ChkProps" Content="Export properties (property sets)" ToolTip="Write each element's property sets into the IFC."/>
                  <TextBlock Style="{StaticResource Lbl}" Text="Read properties from" Margin="18,6,0,2"/>
                  <ComboBox x:Name="CmbPropSource" Margin="18,0,0,6" ToolTip="Which level of the Navisworks selection tree each element's properties come from.&#x0a;&#x0a;Navisworks exports geometry, but most authoring tools put the useful data on the object ABOVE the geometry: Revit's Element tab sits on the element node, SmartPlant 3D and E3D on the occurrence several levels up. 'Geometry + parent object' adds the properties of the nearest composite object above each piece of geometry (Navisworks' Last Object) - the right choice for Revit models.&#x0a;&#x0a;Where the geometry and a parent both carry the same property, the geometry's value is kept.&#x0a;&#x0a;Re-run Smart setup or Scan after changing this, so the property set list and the roles see the new categories."/>
                  <CheckBox x:Name="ChkMaterials" Content="Export materials / colours" ToolTip="Write material names and colours."/>
                  <CheckBox x:Name="ChkQuantities" Content="Compute base quantities (volume / area / length)" ToolTip="Compute and write IfcElementQuantity base quantities."/>
                  <CheckBox x:Name="ChkAutoClassify" Content="Auto-classify unmapped elements (from Revit category and names)" ToolTip="Elements no mapping rule covers get an IFC class from fixed rules instead of IfcBuildingElementProxy: the IFC class a model already states, the Revit category (Walls, Pipes, Structural Framing…), then whole words in family, type and element names. Your mapping rules always win, nothing is guessed when the evidence is ambiguous, and each element records the rule that decided in the BIMCamel_Classification property set."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="PROPERTY SETS TO INCLUDE"/>
                    <Border Style="{StaticResource BadgeAuto}"><TextBlock Text="AUTO" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeAutoTx}"/></Border>
                  </StackPanel>
                  <WrapPanel Margin="0,0,0,9">
                    <!-- "Scan model (sample)" is gone: it was the same scan Smart
                         setup runs. Scan selection stays because it is genuinely
                         different — it reads the elements YOU picked, not a
                         model-wide sample. -->
                    <Button Style="{StaticResource Btn}" Content="Scan selection instead" Click="OnScanSelection" ToolTip="Manual alternative: scan only the elements currently selected in Navisworks, whatever the export scope is set to. Useful when specific elements carry the property sets you care about but you are exporting something wider."/>
                    <Button Style="{StaticResource Btn}" Content="All" Click="OnCatsAll" ToolTip="Tick every property set."/>
                    <Button Style="{StaticResource Btn}" Content="None" Click="OnCatsNone" ToolTip="Untick every property set."/>
                  </WrapPanel>
                  <Grid Margin="0,0,0,6">
                    <TextBox x:Name="TxtCatFilter" TextChanged="OnCatFilter" ToolTip="Show only the property sets whose name contains this text. All and None then act on the ones shown."/>
                    <TextBlock x:Name="LblCatFilterHint" Text="Search property sets…" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource Faint}"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource FieldBd}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource Field}" Padding="4" MaxHeight="160"
                          ToolTip="Property sets to include. If you never scan, all are exported.">
                    <ListBox x:Name="LstCategories" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"><Setter Property="Template"><Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                        </Setter.Value></Setter></Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Checked, Mode=TwoWay}"/></DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                  <TextBlock Style="{StaticResource Hint}" Text="Filled by Smart setup (Export tab). Tick which property sets to export — nothing scanned = all are exported."/>
                </StackPanel>
              </Border>

              <!-- Semantic roles, moved here from the old Semantics tab: they are
                   property-driven ("WHICH property carries the type/level/…"),
                   so they belong with the rest of the property decisions. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource H3}" Text="SEMANTIC ROLES"/>
                    <Border Style="{StaticResource BadgeAuto}"><TextBlock Text="AUTO" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeAutoTx}"/></Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,11"
                             Text="Which source property carries each IFC role. Smart setup fills blank rows from a best guess; edit freely — blank = role off. Storeys are built from the Level role."/>
                  <StackPanel x:Name="RoleHost" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="PARAMETER MAPPING"/>
                    <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="MANUAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Rename a source property or move it into a different IFC property set. Pick the category to disambiguate same-named parameters."/>
                  <DataGrid x:Name="GridParams" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                            Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource FieldBd}" BorderThickness="1"
                            GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Bd}" RowHeight="36"
                            Foreground="{DynamicResource Text}" FontSize="12">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="Category" Width="*" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SourceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellCombo}" Margin="2,0" VerticalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Property" Width="*" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <ComboBox IsEditable="True" ItemsSource="{Binding AvailableProps}" Text="{Binding SourceProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellCombo}" Margin="2,0" VerticalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="To pset" Width="*" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <ComboBox IsEditable="True" ItemsSource="{Binding Psets}" Text="{Binding TargetPset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellCombo}" Margin="2,0" VerticalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="As name" Width="*" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <ComboBox IsEditable="True" ItemsSource="{Binding ParamNames}" Text="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellCombo}" Margin="2,0" VerticalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <WrapPanel Margin="0,9,0,0">
                    <Button Style="{StaticResource Btn}" Content="+ Add mapping" Click="OnParamAdd" ToolTip="Add a new mapping row."/>
                    <Button Style="{StaticResource Btn}" Content="Remove selected" Click="OnParamRemove" ToolTip="Remove the selected mapping row."/>
                    <Button Style="{StaticResource Btn}" Content="Import CSV…" Click="OnParamImportCsv" ToolTip="Add mapping rows from a CSV file with the columns: source category, source property, target pset, target name. A header row is skipped. Edit the list in Excel and bring it back."/>
                    <Button Style="{StaticResource Btn}" Content="Export CSV…" Click="OnParamExportCsv" ToolTip="Save these mapping rows as a CSV file, to edit in Excel or reuse on another project."/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ===== MAPPING ===== -->
        <TabItem x:Name="TabMapping">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="Assign Navisworks sets to IFC classes and classification codes. Optional — Smart setup proposes the rules, this tab is where you edit them.">
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Data="M4,8 L17,8 M14,5 L17,8 L14,11 M20,16 L7,16 M10,13 L7,16 L10,19" StrokeThickness="2"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </Viewbox>
              <!-- The dot appears when pre-flight has a warning this tab fixes. -->
              <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="Mapping" FontSize="12"/>
                <Ellipse x:Name="DotMapping" Width="6" Height="6" Fill="{DynamicResource AmberTx}" Visibility="Collapsed"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-8,0"/>
              </Grid>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,8">
            <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource H3}" Text="MAP NAVISWORKS SETS → IFC CLASSES"/>
                  <Border Style="{StaticResource BadgeAuto}"><TextBlock Text="AUTO" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeAutoTx}"/></Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,11" TextWrapping="Wrap"
                           Text="Each rule assigns one saved set to an IFC class and, optionally, a classification code. Smart setup proposes rules from set names; edit them here. A search set is already an IF/THEN rule — build it in Find Items, save it, map it. Unmapped elements export as IfcBuildingElementProxy. The set list reloads automatically when you open this tab."/>
                <ListBox x:Name="GridMap" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource RuleCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="SET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource CellCombo}" ItemsSource="{Binding Sets}"
                                  SelectedItem="{Binding Set, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Saved selection set or search set."/>
                        <TextBlock Grid.Row="2" Text="AS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource CellCombo}" ItemsSource="{Binding Classes}"
                                  SelectedItem="{Binding IfcClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="IFC class to export the set's elements as."/>
                        <ComboBox Grid.Row="2" Grid.Column="3" Style="{StaticResource CellCombo}" IsEditable="True" ItemsSource="{Binding PredefinedOptions}"
                                  Text="{Binding Predefined, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="IFC PredefinedType for this class (optional). Pick from the values IFC4 defines for it, or type your own."/>
                        <TextBox Grid.Row="2" Grid.Column="5" Style="{StaticResource CellBox}"
                                 Text="{Binding Classification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Classification code for every element in this set (optional), e.g. a Uniclass or OmniClass code. Overrides the Classification property role."/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <!-- ONE toolbar, directly under the grid it edits. The old layout
                     had a second button row below the console, so related actions
                     sandwiched unrelated content. -->
                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource Btn}" Content="+ Add rule" Click="OnMapAdd" ToolTip="Add a new set→class rule."/>
                  <Button Style="{StaticResource Btn}" Content="Remove selected" Click="OnMapRemove" ToolTip="Remove the selected rule."/>
                  <Button Style="{StaticResource Btn}" Content="↑" Click="OnMapUp" ToolTip="Move the selected rule up. When an element is in two mapped sets, the rule higher in this list wins."/>
                  <Button Style="{StaticResource Btn}" Content="↓" Click="OnMapDown" ToolTip="Move the selected rule down. When an element is in two mapped sets, the rule higher in this list wins."/>
                  <Button Style="{StaticResource Btn}" Content="Clear all" Click="OnMapClear" ToolTip="Remove every rule."/>
                  <Button Style="{StaticResource Btn}" Content="Check these rules" Click="OnPreviewMapping" ToolTip="Resolve the rules against the export scope without writing anything. The one-line result shows here; the full breakdown is under Pre-flight on the Export tab."/>
                </WrapPanel>
                <TextBlock x:Name="LblMapSummary" Style="{StaticResource Hint}" Text="Check these rules to see how many elements they map."/>
              </StackPanel>
            </Border>

            <!-- Rules by property value: the same IF/THEN as a search set, without having to
                 build and save one in Navisworks first. -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource H3}" Text="RULES BY PROPERTY VALUE"/>
                  <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,11" TextWrapping="Wrap"
                           Text="IF a property has a value THEN export as a class, with no search set needed. For example: Element / Category equals Walls → IfcWall. These rules only fill what the set rules above left empty, and the first matching rule wins. Scan on the Data tab to fill the property lists."/>
                <!-- One card per rule, read as a sentence: IF category / property test value, THEN
                     class, predefined type, code. Seven grid columns did not fit a docked pane. -->
                <ListBox x:Name="GridPropRules" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource RuleCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="IF" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource CellCombo}" ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Property category, or any."/>
                        <ComboBox Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Style="{StaticResource CellCombo}" IsEditable="True" ItemsSource="{Binding AvailableProps}"
                                  Text="{Binding Property, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Property to test."/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource CellCombo}" ItemsSource="{Binding Tests}"
                                  SelectedItem="{Binding Test, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="How the value is compared. Never case-sensitive."/>
                        <TextBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" Style="{StaticResource CellBox}"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Value to compare with."/>
                        <TextBlock Grid.Row="4" Text="THEN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource CellCombo}" ItemsSource="{Binding Classes}"
                                  SelectedItem="{Binding IfcClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="IFC class to export matching elements as."/>
                        <ComboBox Grid.Row="4" Grid.Column="3" Style="{StaticResource CellCombo}" IsEditable="True" ItemsSource="{Binding PredefinedOptions}"
                                  Text="{Binding Predefined, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="PredefinedType (optional)."/>
                        <TextBox Grid.Row="4" Grid.Column="5" Style="{StaticResource CellBox}"
                                 Text="{Binding Classification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Classification code (optional), e.g. a Uniclass code."/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource Btn}" Content="+ Add rule" Click="OnPropRuleAdd" ToolTip="Add a rule that picks a class by a property value."/>
                  <Button Style="{StaticResource Btn}" Content="Remove selected" Click="OnPropRuleRemove"/>
                  <Button Style="{StaticResource Btn}" Content="↑" Click="OnPropRuleUp" ToolTip="Move up. When two rules match one element, the higher one wins."/>
                  <Button Style="{StaticResource Btn}" Content="↓" Click="OnPropRuleDown" ToolTip="Move down. When two rules match one element, the higher one wins."/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                  <TextBlock Style="{StaticResource H3}" Text="CLASSIFICATION &amp; GROUPS"/>
                  <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="Classification system name"/>
                <TextBox x:Name="TxtClassSystem" ToolTip="Name of the classification system the codes in the grid belong to, e.g. “Uniclass 2015” or “OmniClass”. Written as IfcClassification.Name; blank falls back to a generic source label."/>
                <TextBlock Style="{StaticResource Lbl}" Text="Published by" Margin="0,11,0,5"/>
                <TextBox x:Name="TxtClassSource" ToolTip="Who publishes the classification, e.g. “NBS” for Uniclass. Written as IfcClassification.Source, which IFC2x3 makes mandatory — leave it blank and the system name is used. It is never this exporter’s name: a file claiming BIMCamel publishes Uniclass is a false statement in a deliverable."/>
                <TextBlock Style="{StaticResource Lbl}" Text="Edition" Margin="0,11,0,5"/>
                <TextBox x:Name="TxtClassEdition" ToolTip="Which edition, e.g. “2015”. Uniclass 2015 and Uniclass 1997 are different tables with overlapping codes, so this is what tells the other end whether a code means what they think it means. Mandatory in IFC2x3, where an unstated edition is written as “-”."/>
                <TextBlock Style="{StaticResource Lbl}" Text="Edition date (YYYY-MM-DD)" Margin="0,11,0,5"/>
                <TextBox x:Name="TxtClassEditionDate" ToolTip="The edition’s publication date, as IFC wants it. Anything that is not a plain calendar date is left out rather than guessed at: a malformed date makes a strict reader reject the file, where an absent optional one is perfectly valid."/>
                <TextBlock Style="{StaticResource Lbl}" Text="Published at (URL)" Margin="0,11,0,5"/>
                <TextBox x:Name="TxtClassLocation" ToolTip="Where the classification is published. IFC4 only — IfcClassification gained Location in IFC4, so on IFC2x3 this is not written rather than crammed into a field that means something else."/>
                <TextBlock Style="{StaticResource Lbl}" Text="Also export each mapped set as" Margin="0,11,0,5"/>
                <ComboBox x:Name="CmbGroups" ToolTip="Emit each mapped Navisworks set as an IFC group, with IfcRelAssignsToGroup membership. Use IfcSystem for MEP systems and IfcZone for spatial zones."/>
              </StackPanel>
            </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ===== PROJECT & LOCATION (the old Coordinates and Structure tabs) =====
             Structure was a whole tab for four text boxes, and both tabs answer the
             same question: what is this model and where is it. -->
        <TabItem x:Name="TabCoords">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="What the model is called and where it sits: project, site, building and storey names, the base point and real-world georeferencing. All optional.">
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Data="M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12 M12,12 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" StrokeThickness="2"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </Viewbox>
              <!-- The dot appears when pre-flight has a warning this tab fixes. -->
              <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="Project" FontSize="12"/>
                <Ellipse x:Name="DotCoords" Width="6" Height="6" Fill="{DynamicResource AmberTx}" Visibility="Collapsed"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-8,0"/>
              </Grid>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,8">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="PROJECT &amp; SPATIAL STRUCTURE"/>
                    <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Lbl}" Text="Project name (blank = the model's file name)"/>
                  <TextBox x:Name="TxtProject" Text="" ToolTip="Name written to the IfcProject. Leave blank to use the Navisworks file's name, which is what most receivers expect to see."/>
                  <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{StaticResource Lbl}" Text="Site name"/>
                      <TextBox x:Name="TxtSite" Text="Site" ToolTip="Name written to the IfcSite."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Lbl}" Text="Building name"/>
                      <TextBox x:Name="TxtBuilding" Text="Building" ToolTip="Name written to the IfcBuilding."/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Style="{StaticResource Lbl}" Text="Fallback storey (items with no level)" Margin="0,11,0,5"/>
                  <TextBox x:Name="TxtStorey" Text="Storey" ToolTip="Storey for elements whose Level role is empty."/>
                  <TextBlock Style="{StaticResource Hint}" Text="Storeys come from the Level role on the Data tab."/>
                  <!-- What the storeys will actually be, from the last check: before
                       this, nobody saw them until the IFC was open in another tool. -->
                  <TextBlock Style="{StaticResource Lbl}" Text="Storeys found by the last check" Margin="0,11,0,5"/>
                  <Border Background="{DynamicResource ConsoleBg}" CornerRadius="9" Padding="11" MaxHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtStoreys" Foreground="{DynamicResource ConsoleTx}" FontFamily="Consolas" FontSize="11"
                                 Text="Run Smart setup or Run full check (Export tab) to list them."/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="BASE POINT"/>
                    <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                  </StackPanel>
                  <ComboBox x:Name="CmbBasePoint" ToolTip="Where the IFC local origin sits. This only affects how large the stored coordinates are — the placement chain puts the model back at its world position either way. Real-world georeferencing is the survey point below."/>
                  <StackPanel x:Name="CoordRow" Margin="0,11,0,0" Visibility="Collapsed"
                              ToolTip="Custom base point: easting, northing and elevation in metres.">
                    <TextBlock Style="{StaticResource Lbl}" Text="E, N, Elevation (m)"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="TxtE" Grid.Column="0"/><TextBox x:Name="TxtN" Grid.Column="2"/>
                      <TextBox x:Name="TxtElev" Grid.Column="4"/>
                    </Grid>
                  </StackPanel>
                  <!-- Live — recomputes as the mode or numbers change. The old
                       "Preview base point" button duplicated exactly this. -->
                  <TextBlock x:Name="LblPreview" Style="{StaticResource Hint}" FontFamily="Consolas" Text="Base point preview: —"/>
                  <Button Style="{StaticResource LinkBtn}" Content="↳ Check federated model origins" Click="OnFederationReport"
                          ToolTip="List every loaded model's origin, rotation and units in the panel below, and flag any disagreement — before you export."/>
                  <Border x:Name="CoordReportBox" Background="{DynamicResource ConsoleBg}" CornerRadius="9" Padding="11" Margin="0,9,0,0" MaxHeight="180" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtCoordReport" Foreground="{DynamicResource ConsoleTx}" FontFamily="Consolas"
                                 FontSize="11" TextWrapping="NoWrap" Text=""/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Style="{StaticResource H3}" Text="GEOREFERENCING"/>
                    <Border Style="{StaticResource BadgeOpt}"><TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeOptTx}"/></Border>
                  </StackPanel>
                  <CheckBox x:Name="ChkGeoref" Content="Write IFC4 georeferencing (IfcMapConversion)" ToolTip="Record where the model sits in a real-world projected CRS. IFC4 only. Written only when you supply a CRS or a survey point below — an empty map conversion is worse than none."/>
                  <StackPanel x:Name="GeorefRow" Margin="20,7,0,4">
                    <TextBlock Style="{StaticResource Lbl}" Text="Coordinate reference system (e.g. EPSG:27700)"/>
                    <TextBox x:Name="TxtCrs"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Survey point — model origin in the CRS: E, N, Elevation (m), rotation (°)" Margin="0,7,0,5"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="TxtSurveyE" Grid.Column="0"/><TextBox x:Name="TxtSurveyN" Grid.Column="2"/>
                      <TextBox x:Name="TxtSurveyElev" Grid.Column="4"/><TextBox x:Name="TxtRot" Grid.Column="6"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="The survey point is independent of the base point: the base point only decides how big the stored numbers are, this decides where the model is on earth."/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

      <!-- Action bar -->
      <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0" Padding="14,11,14,13">
        <StackPanel>
          <Grid Margin="0,0,0,7">
            <TextBlock x:Name="LblStatus" Text="Ready." FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="LblModel" Text="" FontSize="11" Foreground="{DynamicResource Ok}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </Grid>
          <!-- Stop lives OUT here rather than on a tab, because BeginBusy sets
               Tabs.IsEnabled=false — a cancel button inside the tabs would be
               greyed out during exactly the operation it exists to stop. -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="BtnCancel" Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="12,3"
                    Content="Stop" Click="OnCancelWork" Visibility="Collapsed"
                    ToolTip="Stop the scan. Nothing has been written to disk — settings already filled in are kept, and you can run it again."/>
          </Grid>
          <Button x:Name="BtnExport" Style="{StaticResource PrimaryBtn}" Click="OnExport" ToolTip="Export to IFC with the current settings (you'll choose where to save).">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                <Path Data="M12,3 L12,15 M8,11 L12,15 L16,11 M4,17 L4,19 A2,2 0 0 0 6,21 L18,21 A2,2 0 0 0 20,19 L20,17" Stroke="White" StrokeThickness="2"/>
              </Viewbox>
              <!-- Says what the click will do — schema, form, how many files — and is
                   updated as those settings change. -->
              <TextBlock x:Name="LblExportBtn" Text="Export IFC"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
