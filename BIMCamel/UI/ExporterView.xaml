<UserControl x:Class="BIMCamel.UI.ExporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             ToolTipService.ShowDuration="20000" ToolTipService.InitialShowDelay="350"
             FontFamily="Segoe UI" FontSize="13">

  <UserControl.Resources>
    <!-- ════ Palette (light defaults; ApplyTheme swaps every key for dark) ════ -->
    <SolidColorBrush x:Key="Accent"      Color="#0070C0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0D83DA"/>
    <SolidColorBrush x:Key="AccentPress" Color="#005A9C"/>
    <SolidColorBrush x:Key="Bg"          Color="#EEF1F5"/>
    <SolidColorBrush x:Key="Pane"        Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Card"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Card2"       Color="#FBFCFD"/>
    <SolidColorBrush x:Key="Text"        Color="#1F2329"/>
    <SolidColorBrush x:Key="Muted"       Color="#5C646F"/>
    <SolidColorBrush x:Key="Faint"       Color="#767E89"/>
    <SolidColorBrush x:Key="Bd"          Color="#E1E5EA"/>
    <SolidColorBrush x:Key="BdStrong"    Color="#CDD3DA"/>
    <SolidColorBrush x:Key="Field"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBd"     Color="#CDD3DA"/>
    <SolidColorBrush x:Key="Nav"         Color="#EAEDF1"/>
    <SolidColorBrush x:Key="NavActive"   Color="#E6F0FA"/>
    <SolidColorBrush x:Key="Track"       Color="#D8DDE3"/>
    <SolidColorBrush x:Key="FamBatch"    Color="#4D7C0F"/>
    <SolidColorBrush x:Key="Ok"          Color="#1A8F4C"/>
    <SolidColorBrush x:Key="OkBg"        Color="#E4F6EC"/>
    <SolidColorBrush x:Key="OkBd"        Color="#B7E3C9"/>
    <SolidColorBrush x:Key="AmberBg"     Color="#FFF7E6"/>
    <SolidColorBrush x:Key="AmberBd"     Color="#FFE1A8"/>
    <SolidColorBrush x:Key="AmberTx"     Color="#8A5A00"/>
    <SolidColorBrush x:Key="RedBg"       Color="#FDECEC"/>
    <SolidColorBrush x:Key="RedBd"       Color="#F3C6C6"/>
    <SolidColorBrush x:Key="RedTx"       Color="#B3261E"/>
    <SolidColorBrush x:Key="ConsoleBg"   Color="#0E1116"/>
    <SolidColorBrush x:Key="ConsoleTx"   Color="#CFE3D5"/>
    <SolidColorBrush x:Key="BadgeReqBg"  Color="#E4F6EC"/>
    <SolidColorBrush x:Key="BadgeReqBd"  Color="#B7E3C9"/>
    <SolidColorBrush x:Key="BadgeReqTx"  Color="#1A8F4C"/>
    <SolidColorBrush x:Key="BadgeOptBg"  Color="#EAEDF1"/>
    <SolidColorBrush x:Key="BadgeOptBd"  Color="#E1E5EA"/>
    <SolidColorBrush x:Key="BadgeOptTx"  Color="#5C646F"/>
    <SolidColorBrush x:Key="BadgeAutoBg" Color="#E6F0FA"/>
    <SolidColorBrush x:Key="BadgeAutoBd" Color="#BBD8F2"/>
    <SolidColorBrush x:Key="BadgeAutoTx" Color="#0F5FA0"/>
    <LinearGradientBrush x:Key="BrandBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#0070C0" Offset="0"/><GradientStop Color="#0D83DA" Offset="1"/>
    </LinearGradientBrush>

    <!-- ════ Glyphs: the CamelWorks 24-unit stroked set ════ -->
    <Geometry x:Key="G_onward">M5,12 L18,12 M13,7 L18,12 L13,17</Geometry>
    <Geometry x:Key="G_table">M3,5 L21,5 L21,19 L3,19 Z M3,10 L21,10 M3,14.5 L21,14.5 M9,10 L9,19 M15,10 L15,19</Geometry>
    <Geometry x:Key="G_group">M3,4 L10,4 L10,11 L3,11 Z M14,4 L21,4 L21,11 L14,11 Z M8.5,14 L15.5,14 L15.5,20 L8.5,20 Z</Geometry>
    <Geometry x:Key="G_model">M12,3 L21,7.5 L12,12 L3,7.5 Z M3,12 L12,16.5 L21,12 M3,16.5 L12,21 L21,16.5</Geometry>
    <Geometry x:Key="G_report">M6,3 L15,3 L19,7 L19,21 L6,21 Z M15,3 L15,7 L19,7 M9,12 L16,12 M9,16 L16,16</Geometry>
    <Geometry x:Key="G_tune">M4,7 L20,7 M4,17 L20,17 M9,4.5 L9,9.5 M15,14.5 L15,19.5</Geometry>
    <Geometry x:Key="G_find">M11,4 A7,7 0 1 0 11.01,4 M16.2,16.2 L21,21</Geometry>
    <Geometry x:Key="G_add">M12,5 L12,19 M5,12 L19,12</Geometry>
    <Geometry x:Key="G_tick">M5,13 L10,17.5 L19,6.5</Geometry>
    <Geometry x:Key="G_bin">M5,7 L19,7 M10,7 L10,4 L14,4 L14,7 M6.5,7 L7.7,20 L16.3,20 L17.5,7</Geometry>
    <Geometry x:Key="G_read">M12,6 C10,4.5 7.5,4 4,4 L4,18 C7.5,18 10,18.5 12,20 M12,6 C14,4.5 16.5,4 20,4 L20,18 C16.5,18 14,18.5 12,20 M12,6 L12,20</Geometry>
    <Geometry x:Key="G_save">M4,4 L16,4 L20,8 L20,20 L4,20 Z M8,4 L8,10 L15,10 L15,4 M8,20 L8,14 L16,14 L16,20</Geometry>
    <Geometry x:Key="G_folder">M3,6.5 L9.5,6.5 L11.5,9 L21,9 L21,19 L3,19 Z</Geometry>
    <Geometry x:Key="G_copy">M9,9 L20,9 L20,20 L9,20 Z M5,15 L5,4 L16,4</Geometry>
    <Geometry x:Key="G_layers">M4,9 L11,9 L11,20 L4,20 Z M13,4 L20,4 L20,15 L13,15 Z</Geometry>
    <Geometry x:Key="G_columns">M3,4 L21,4 L21,20 L3,20 Z M9,4 L9,20 M15,4 L15,20</Geometry>
    <Geometry x:Key="G_filter">M3,5 L21,5 L14,13 L14,20 L10,18 L10,13 Z</Geometry>
    <Geometry x:Key="G_link">M10,14 A4,4 0 0 1 10,8.4 L13,5.4 A4,4 0 0 1 18.6,11 L17.2,12.4 M14,10 A4,4 0 0 1 14,15.6 L11,18.6 A4,4 0 0 1 5.4,13 L6.8,11.6</Geometry>
    <Geometry x:Key="G_sphere">M12,5 A7,7 0 1 0 12.01,5 M5.4,9.5 C9.4,11.9 14.6,11.9 18.6,9.5</Geometry>
    <Geometry x:Key="G_ruler">M3,9 L21,9 L21,15 L3,15 Z M7,9 L7,12 M11,9 L11,13 M15,9 L15,12 M19,9 L19,13</Geometry>
    <Geometry x:Key="G_info">M12,3 A9,9 0 1 0 12.01,3 M12,11 L12,16.5 M12,7.5 L12,7.9</Geometry>
    <Geometry x:Key="G_theme">M20,13.5 A8.5,8.5 0 1 1 10.5,4 A6.6,6.6 0 0 0 20,13.5 Z</Geometry>
    <Geometry x:Key="G_down">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="G_right">M9,6 L15,12 L9,18</Geometry>
    <Geometry x:Key="G_close">M6,6 L18,18 M18,6 L6,18</Geometry>

    <!-- A glyph: Tag is the geometry, Foreground the stroke. 14 px unless sized. -->
    <Style x:Key="Ico" TargetType="ContentControl">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
              <Canvas Width="24" Height="24">
                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Canvas>
            </Viewbox>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Text ════ -->
    <!-- Section eyebrow inside a card: FILE SIZE AND SPEED, READ PROPERTIES FROM, REPORT. -->
    <Style x:Key="H3" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- The one line under a card title, and plain explanations. -->
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <!-- A switch or radio row's second line. -->
    <Style x:Key="Desc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="16"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>
    <!-- Form labels: a fixed column so the fields line up. -->
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="L76" TargetType="TextBlock" BasedOn="{StaticResource Lbl}"><Setter Property="Width" Value="76"/></Style>
    <Style x:Key="L96" TargetType="TextBlock" BasedOn="{StaticResource Lbl}"><Setter Property="Width" Value="96"/></Style>
    <Style x:Key="L104" TargetType="TextBlock" BasedOn="{StaticResource Lbl}"><Setter Property="Width" Value="104"/></Style>
    <Style x:Key="FormRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>

    <!-- ════ Card ════ -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="CardHead" TargetType="Grid">
      <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Bd}"/>
      <Setter Property="Margin" Value="0,8,0,10"/>
    </Style>
    <Style x:Key="Step" TargetType="Border">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextElement.Foreground" Value="White"/>
      <Setter Property="TextElement.FontSize" Value="11"/>
      <Setter Property="TextElement.FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="HeadIco" TargetType="ContentControl" BasedOn="{StaticResource Ico}">
      <Setter Property="Width" Value="17"/>
      <Setter Property="Height" Value="17"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
    </Style>

    <!-- REQUIRED / OPTIONAL / AUTO marks, top right of a card. -->
    <Style x:Key="ChipReq" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BadgeReqBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BadgeReqBd}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="7,1"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeReqTx}"/>
      <Setter Property="TextElement.FontSize" Value="10.5"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ChipOpt" TargetType="Border" BasedOn="{StaticResource ChipReq}">
      <Setter Property="Background" Value="{DynamicResource BadgeOptBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BadgeOptBd}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeOptTx}"/>
    </Style>
    <Style x:Key="ChipAuto" TargetType="Border" BasedOn="{StaticResource ChipReq}">
      <Setter Property="Background" Value="{DynamicResource BadgeAutoBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BadgeAutoBd}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeAutoTx}"/>
    </Style>

    <!-- A dark console block: reports, summaries, storey lists. -->
    <Style x:Key="Console" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ConsoleBg}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ConsoleTx}"/>
      <Setter Property="TextElement.FontFamily" Value="Consolas"/>
      <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>

    <!-- ════ TextBox: 31 px; Tag is the placeholder ════ -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBd}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Faint}" Margin="2,0,0,0"
                           IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
    <!-- A number beside a switch: 56 px, right-aligned, unit after it. -->
    <Style x:Key="InlineNum" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Width" Value="56"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Margin" Value="8,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ════ Rule cards (set rules, property rules, parameter rows) ════ -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RuleCard" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="rb" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="9" Padding="10,8,10,10">
                <ContentPresenter/>
              </Border>
              <!-- Where a dragged card lands. -->
              <Border x:Name="drop" Height="3" VerticalAlignment="Top" CornerRadius="2" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="rb" Property="BorderBrush" Value="{DynamicResource BdStrong}"/></Trigger>
              <Trigger Property="Tag" Value="drop"><Setter TargetName="drop" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="Tag" Value="drag"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- The six-dot handle a rule card is dragged by. -->
    <Style x:Key="Grip" TargetType="ContentControl">
      <Setter Property="Tag" Value="grip"/>
      <Setter Property="Cursor" Value="SizeAll"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Margin" Value="-3,0,5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="Drag to reorder. The higher rule wins. Alt+↑ / Alt+↓ also move a rule."/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border Background="Transparent" Padding="3,4">
              <Path Fill="{DynamicResource Faint}" Data="M0,0 h2 v2 h-2 Z M5,0 h2 v2 h-2 Z M0,5 h2 v2 h-2 Z M5,5 h2 v2 h-2 Z M0,10 h2 v2 h-2 Z M5,10 h2 v2 h-2 Z"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- × on a card: remove it. Tag="remove" is what the list's click handler looks for. -->
    <Style x:Key="CloseBtn" TargetType="Button">
      <Setter Property="Tag" Value="remove"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ToolTip" Value="Remove"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="22" Height="22" CornerRadius="6" Background="Transparent">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_close}" Width="11" Height="11" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Nav}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pop-up menus built in code (profile menu, chip menu). Code merges this dictionary into
         each menu, so the theme brushes resolve inside the pop-up too. -->
    <Style x:Key="PaneMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,6">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaneMenuSep" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource Bd}"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaneMenu" TargetType="ContextMenu">
      <Setter Property="ItemContainerStyle" Value="{StaticResource PaneMenuItem}"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Margin="0,2,10,12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                    CornerRadius="8" Padding="4" MinWidth="300">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A row in the + Token pop-up: label left, what it fills in right. -->
    <Style x:Key="TokenRow" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,5">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- File name editor: a token chip and the plain text between chips. -->
    <Style x:Key="NameChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BadgeAutoBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BadgeAutoBd}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="7,1,2,1"/>
      <Setter Property="Margin" Value="1,2"/>
      <Setter Property="Cursor" Value="SizeAll"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeAutoTx}"/>
    </Style>
    <!-- A chip that has no value in the current scope: grey, and left out of the name. -->
    <Style x:Key="NameChipOff" TargetType="Border" BasedOn="{StaticResource NameChip}">
      <Setter Property="Background" Value="{DynamicResource Nav}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Faint}"/>
    </Style>
    <Style x:Key="ChipCtl" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" Padding="3,0" CornerRadius="4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A0F5FA0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NameText" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="2,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Buttons ════ -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource FieldBd}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="Transparent"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Bd}"/>
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <TextBlock Background="Transparent" Text="{TemplateBinding Content}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Padding="15,7" Background="{DynamicResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentPress}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Brand-bar button: white glyph on a translucent plate. -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="#4AFFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#6BFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ CheckBox (tick lists) ════ -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <!-- A grid, not a horizontal stack: a stack gives the label infinite width, so a long
                 one ran off the card instead of wrapping. -->
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="16" Height="16" CornerRadius="5" BorderThickness="1.5"
                      BorderBrush="{DynamicResource BdStrong}" Background="{DynamicResource Field}" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M2.5,6.5 L5,9 L10,3.5" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                      Stretch="None" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Switch: an on/off setting with a title and, optionally, a line below ════ -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="track" Width="34" Height="20" CornerRadius="10" Background="{DynamicResource BdStrong}"
                      VerticalAlignment="Top" Margin="0,0,0,0">
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                  <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.25"/></Ellipse.Effect>
                </Ellipse>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Top">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Option rows (scope radios; property source list) ════ -->
    <Style x:Key="OptionCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="9"
                    Padding="11,7" Background="{DynamicResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="15" Height="15" VerticalAlignment="Center">
                  <Ellipse x:Name="ring" Stroke="{DynamicResource BdStrong}" StrokeThickness="1.5" Fill="{DynamicResource Field}"/>
                  <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/>
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RadioList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <StackPanel IsItemsHost="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="9"
                          Padding="11,8" Background="{DynamicResource Card}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Ellipse x:Name="ring" Stroke="{DynamicResource BdStrong}" StrokeThickness="1.5" Fill="{DynamicResource Field}"/>
                        <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                      </Grid>
                      <ContentPresenter Grid.Column="1" Margin="11,0,0,0"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      <Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/>
                      <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                      <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Segmented choice (schema, quality): one plate, the picked segment raised ════ -->
    <Style x:Key="Seg" TargetType="ListBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{DynamicResource Nav}" CornerRadius="8" Padding="3">
              <UniformGrid Rows="1" IsItemsHost="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" CornerRadius="6" Padding="4,5" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                      <Setter TargetName="b" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.12"/></Setter.Value></Setter>
                      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ ComboBox (flat, rounded; Tag is the placeholder) ════ -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavActive}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="Padding" Value="10,0,8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBd}"
                            BorderThickness="1" CornerRadius="8" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <!-- The typed text sits exactly where the picked text does: same padding, and the
                   arrow's column kept clear. -->
              <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="{TemplateBinding IsEditable}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" Margin="1,0,0,0"/>
                <TextBox x:Name="PART_EditableTextBox" MinHeight="0" Height="Auto" Padding="0" VerticalAlignment="Center"
                         Background="Transparent" Foreground="{DynamicResource Text}" Visibility="Hidden">
                  <TextBox.Template>
                    <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate>
                  </TextBox.Template>
                </TextBox>
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                        CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,4,0,0" SnapsToDevicePixels="True">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
                  <ScrollViewer MaxHeight="260"><StackPanel IsItemsHost="True" Margin="0,4"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsEditable" Value="True"/>
                  <Condition Property="Text" Value=""/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsEditable" Value="False"/>
                  <Condition Property="SelectedItem" Value="{x:Null}"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
    <Style x:Key="MonoCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ════ Slim scroll bar ════ -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border CornerRadius="3" Background="{DynamicResource BdStrong}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
              <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                  <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ════ Progress: a 3 px line on top of the footer ════ -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Accent}"/>
              <!-- Busy with no count: a short bar runs across the line. -->
              <Border x:Name="run" Width="90" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed">
                <Border.RenderTransform><TranslateTransform X="-90"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="run" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="runSb">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="run" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-90" To="600" Duration="0:0:1.6"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="runSb"/></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ════ Tabs: five equal tabs, glyph + label, a green underline on the open one ════ -->
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource Pane}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1" Padding="6,0">
                <UniformGrid Rows="1" IsItemsHost="True"/>
              </Border>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource Text}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Background="Transparent" Cursor="Hand">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" Margin="0,9,0,10"/>
              <Border x:Name="ul" Height="2" VerticalAlignment="Bottom" Margin="1,0" Background="Transparent"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ul" Property="Background" Value="{DynamicResource FamBatch}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The dot a tab gets when pre-flight has a warning that tab fixes. -->
    <Style x:Key="TabDot" TargetType="Ellipse">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Fill" Value="{DynamicResource AmberTx}"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="3,1,0,0"/>
    </Style>
    <Style x:Key="TabBody" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="12,12,12,0"/>
    </Style>
  </UserControl.Resources>

  <!-- ════════════════════ LAYOUT ════════════════════ -->
  <Border Background="{DynamicResource Pane}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Brand bar: the white camel, the tool's name, version and profile, and the four
           buttons that act on the whole pane. -->
      <Border Grid.Row="0" Background="{DynamicResource BrandBar}" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image x:Name="LogoMark" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="LblTitle" Text="BIMCamel IFC Exporter" Foreground="White" FontSize="17" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Ideal"/>
            <TextBlock x:Name="LblSubtitle" Foreground="#CCFFFFFF" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="The plug-in version and the profile these settings came from. A dot means they were changed after it was loaded."/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- One menu for every way of replacing the current settings: a saved profile, a
                 built-in preset, or the defaults. -->
            <Button x:Name="BtnLoadProfile" Style="{StaticResource IconBtn}" Margin="0" Click="OnProfileMenu"
                    ToolTip="Load a saved profile, apply a built-in preset, or reset everything to defaults.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_down}" Width="15" Height="15" Foreground="White"/>
            </Button>
            <Button x:Name="BtnSaveProfile" Style="{StaticResource IconBtn}" Click="OnSaveProfile"
                    ToolTip="Save the export settings (schema, scope, options, coordinates, roles, parameter rules and the set mapping) to a reusable .json profile. List ticks and the theme are not stored.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_save}" Width="15" Height="15" Foreground="White"/>
            </Button>
            <Button x:Name="BtnTheme" Style="{StaticResource IconBtn}" ToolTip="Switch between light and dark theme" Click="OnToggleTheme">
              <ContentControl x:Name="IcoTheme" Style="{StaticResource Ico}" Tag="{StaticResource G_theme}" Width="15" Height="15" Foreground="White"/>
            </Button>
            <Button x:Name="BtnAbout" Style="{StaticResource IconBtn}" ToolTip="About BIMCamel IFC Exporter" Click="OnAbout">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_info}" Width="15" Height="15" Foreground="White"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <!-- ═══════════════ EXPORT ═══════════════ -->
        <TabItem x:Name="TabExport">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" ToolTip="What to export, the file format and name, Smart setup and the pre-flight checks.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_onward}"/>
              <TextBlock Text="Export" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer Style="{StaticResource TabBody}">
            <StackPanel>
              <!-- DataTools warning (dismissible) -->
              <Border x:Name="WarnBanner" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                      Background="{DynamicResource AmberBg}" BorderBrush="{DynamicResource AmberBd}" BorderThickness="1">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" VerticalAlignment="Top" Margin="10,0,0,0"
                          Foreground="{DynamicResource AmberTx}" FontWeight="SemiBold" Content="Dismiss" Click="OnDismissWarning"
                          ToolTip="Hide this notice. It stays hidden next time."/>
                  <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{DynamicResource AmberTx}"><Run FontWeight="SemiBold" Text="Before a big export:"/><Run Text=" deactivate DataTools and external-database links (Home → DataTools). They run a database query per object and can take most of the export time."/></TextBlock>
                </DockPanel>
              </Border>

              <!-- 1 · What to export -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Step}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="What to export"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipReq}"><TextBlock Text="REQUIRED"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Defaults are already valid"/>
                  <StackPanel x:Name="ScopeOptions"/>
                  <TextBlock x:Name="LblScopeHint" Margin="2,0,0,6" Foreground="{DynamicResource AmberTx}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Sub}">
                        <Style.Triggers>
                          <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel x:Name="SavedSetRow" Visibility="Collapsed" Margin="0,0,0,2">
                    <ComboBox x:Name="CmbSavedSet" Tag="Pick a saved set or search set" ToolTip="The saved selection set or search set to export."/>
                  </StackPanel>
                  <!-- Batch: tick the sets, each becomes its own IFC. -->
                  <Border x:Name="BatchRow" Visibility="Collapsed" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="9"
                          Background="{DynamicResource Card2}" Padding="10" Margin="0,0,0,2">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Style="{StaticResource LinkBtn}" Content="All" Click="OnBatchAll" Margin="0,0,10,0" ToolTip="Tick every set shown."/>
                          <Button Style="{StaticResource LinkBtn}" Content="None" Click="OnBatchNone" ToolTip="Untick every set shown. Ticks of sets hidden by the search are kept."/>
                        </StackPanel>
                        <TextBlock x:Name="LblBatchCount" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Text="0 of 0 sets ticked · one IFC each"/>
                      </DockPanel>
                      <TextBox x:Name="TxtBatchFilter" Tag="Search sets" TextChanged="OnBatchFilter" Margin="0,0,0,6"
                               ToolTip="Show only the sets whose name contains this text. All and None then act on the ones shown."/>
                      <ListBox x:Name="LstBatch" BorderThickness="0" Background="Transparent" MaxHeight="230"
                               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ToolTip="Tick the sets to export; each becomes its own IFC file.">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0" Padding="2,5"><ContentPresenter/></Border>
                              </ControlTemplate>
                            </Setter.Value></Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <CheckBox Content="{Binding Name}" IsChecked="{Binding Checked, Mode=TwoWay}"/>
                              <TextBlock Grid.Column="1" Text="{Binding Detail}" FontFamily="Consolas" FontSize="11.5" Margin="10,0,0,0"
                                         Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock x:Name="LblBatchEmpty" Style="{StaticResource Sub}" Margin="2,4,0,0" Visibility="Collapsed"/>
                      <DockPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Lbl}" Width="62" Text="Output folder"/>
                        <TextBox x:Name="TxtBatchFolder" Tag="Asked at export" ToolTip="Where the batch writes its files. Leave blank to choose the folder when you press Export."/>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <!-- 2 · Format -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Step}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Format"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipReq}"><TextBlock Text="REQUIRED"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Schema, units and quality are defaulted"/>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L76}" Text="Schema"/>
                    <ListBox x:Name="CmbSchema" Style="{StaticResource Seg}" ToolTip="IFC version to write. IFC4 is recommended; choose IFC2x3 only if the receiving software requires it.">
                      <ListBoxItem Content="IFC4"/>
                      <ListBoxItem Content="IFC2x3"/>
                    </ListBox>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L76}" Text="Units"/>
                    <ComboBox x:Name="CmbUnits" ToolTip="Length unit of the source model. 'Auto' reads it from the model. Only override it if the model's units are wrong."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L76}" Text="Quality"/>
                    <ListBox x:Name="CmbQuality" Style="{StaticResource Seg}" ToolTip="Vertex welding tolerance and stored coordinate precision. Balanced suits most models; Small file welds more coarsely, High detail keeps finer detail and writes larger files. Navisworks fixes the mesh tessellation when the NWC is made, so this cannot add detail that is not already there.">
                      <ListBoxItem Content="Small file"/>
                      <ListBoxItem Content="Balanced"/>
                      <ListBoxItem Content="High detail"/>
                    </ListBox>
                  </DockPanel>
                  <DockPanel Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource L76}" Text="Compress" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <CheckBox x:Name="ChkZip" Style="{StaticResource Switch}" Margin="0" Content="Write .ifczip"
                              ToolTip="Write IFC's standard zipped form: an ordinary ZIP holding one .ifc, read directly by Revit, Solibri, ArchiCAD, Navisworks, xBim and IfcOpenShell with no unpacking step.&#x0a;&#x0a;STEP text compresses very well, so this is typically 6-12x smaller on disk. It also writes LESS data: the export streams straight into the archive, so the uncompressed file is never created at all.&#x0a;&#x0a;Turn it off if a downstream script expects a literal .ifc."/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- 3 · File name -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Step}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="File name"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipReq}"><TextBlock Text="REQUIRED"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Chips and your own text. Greyed chips do not apply to this scope and are left out."/>
                  <!-- The template string itself, which profiles store. The editor below is built
                       from it and writes back to it; nobody types tokens by hand any more. -->
                  <TextBox x:Name="TxtFileName" Text="{}{model}_{schema}" Visibility="Collapsed"/>
                  <Border x:Name="NameEditor" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBd}" BorderThickness="1"
                          CornerRadius="8" Padding="4,2,4,2" MinHeight="34" AllowDrop="True"
                          ToolTip="The exported file's name. Blue chips are filled in at export; type plain text between them. Drag a chip, or use ‹ ›, to move it; × removes it.">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <WrapPanel x:Name="NameChips" VerticalAlignment="Center" Background="Transparent"/>
                      <Button x:Name="BtnAddToken" Grid.Column="1" Style="{StaticResource LinkBtn}" Margin="6,0,4,0" VerticalAlignment="Center"
                              Content="+ Token" Click="OnAddToken" ToolTip="Insert a value that is filled in at export (model, set, selected element, date…) or your own text."/>
                    </Grid>
                  </Border>
                  <!-- + Token: every token with what it would fill in now, and a field for plain text. -->
                  <Popup x:Name="TokenPopup" PlacementTarget="{Binding ElementName=NameEditor}" Placement="Bottom" StaysOpen="False"
                         AllowsTransparency="True" PopupAnimation="Fade">
                    <Border x:Name="TokenCard" Margin="0,4,10,12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                            CornerRadius="8" Padding="4" Width="{Binding ActualWidth, ElementName=NameEditor}">
                      <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
                      <StackPanel>
                        <StackPanel x:Name="TokenList"/>
                        <DockPanel Margin="4,6,4,4">
                          <Button x:Name="BtnAddText" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="6,0,0,0" Content="Add text" Click="OnAddOwnText"/>
                          <TextBox x:Name="TxtOwnText" Tag="Your own text" ToolTip="Plain text to add to the end of the name, such as a revision."/>
                        </DockPanel>
                      </StackPanel>
                    </Border>
                  </Popup>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                    <Run Text="Will be saved as"/>
                    <Run x:Name="LblNamePreview" FontFamily="Consolas" Foreground="{DynamicResource Text}"/>
                  </TextBlock>
                </StackPanel>
              </Border>

              <!-- 4 · Smart setup. One button for every auto-detect the pane has. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Step}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Smart setup"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipAuto}"><TextBlock Text="AUTO"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Scans the scope above, fills blank roles, proposes rules and checks them. It never overwrites what you typed."/>
                  <WrapPanel>
                    <Button Style="{StaticResource Btn}" Click="OnSmartSetup"
                            ToolTip="Runs every auto-detect in sequence over the scope selected above. Takes roughly as long as collecting that scope once (geometry is not read); use Stop beside Export to interrupt it. Re-running only fills blanks and never overwrites your entries. One nuance: a role or rule you deliberately blanked counts as blank, so it will be proposed again.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_tune}" Margin="0,0,7,0"/><TextBlock Text="Smart setup"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="OnPreviewMapping"
                            ToolTip="Resolve the mapping rules and roles against the scope above, without writing anything: how many elements map, to which classes, how many fall back to proxy, property coverage and geometry size. Takes about as long as collecting the scope once.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_find}" Margin="0,0,7,0"/><TextBlock Text="Run full check"/></StackPanel>
                    </Button>
                  </WrapPanel>
                  <Border Margin="0,10,0,0">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Console}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=TxtSmartSummary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtSmartSummary" Text="" LineHeight="17"/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>

              <!-- 5 · Pre-flight. Everything worth knowing about the output before Export is
                   pressed. Informational only: it never blocks the one-click export. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Step}"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Pre-flight"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <DockPanel Margin="0,0,0,8">
                    <ToggleButton x:Name="TglCheckDetails" DockPanel.Dock="Right" Style="{StaticResource LinkToggle}" Content="Show details" Margin="10,0,0,0"
                                  ToolTip="Show each row's explanation and the full breakdown from the last check."/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0" Text="Informational only. Export never waits on it."/>
                  </DockPanel>
                  <StackPanel x:Name="PreflightHost"/>
                  <TextBlock x:Name="LblPreflightWhen" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Live rows only"/>
                  <Border x:Name="CheckDetails" Style="{StaticResource Console}" Margin="0,8,0,0" MaxHeight="260" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtPreview" TextWrapping="NoWrap" LineHeight="17"
                                 Text="Run full check to see how many elements map, and how many will export as IfcBuildingElementProxy."/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Advanced: size, speed and diagnostics. Collapsed by default; the header counts
                   settings that differ from the defaults, so a loaded profile never hides a change. -->
              <Border Background="{DynamicResource Nav}" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                  <ToggleButton x:Name="TglAdvanced" Cursor="Hand" Focusable="True" Tag="defaults"
                                ToolTip="Show or hide the size, speed and diagnostics options.">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <ContentControl x:Name="chev" Style="{StaticResource Ico}" Tag="{StaticResource G_right}" Width="15" Height="15"
                                          Foreground="{DynamicResource Text}" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <ContentControl.RenderTransform><RotateTransform Angle="0"/></ContentControl.RenderTransform>
                          </ContentControl>
                          <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Advanced options"/>
                          <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                                     Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chev" Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>

                  <StackPanel x:Name="AdvancedBody" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource H3}" Text="FILE SIZE AND SPEED" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkInstancing" Style="{StaticResource Switch}" ToolTip="Reuse identical geometry across elements to shrink the file and speed up export.">
                      <StackPanel><TextBlock Text="Instance repeated geometry"/><TextBlock Style="{StaticResource Desc}" Text="Stores repeated shapes once. A much smaller file on repetitive models."/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkFastInstancing" Style="{StaticResource Switch}" ToolTip="Skip re-reading the geometry of elements that look like a repeat of one already read (same tree type, size, fragment count and colour). Reading triangles is 80-90% of the export, and most models repeat their shapes many times, so this can be several times faster.&#x0a;&#x0a;It is a GUESS about the model, so it checks itself: every 20th repeat is read for real and compared. Any disagreement is reported, that shape is dropped, and the file stays correct. Turn this on only after a run reports zero mismatches on YOUR model.&#x0a;&#x0a;Needs instancing to be on.">
                      <StackPanel><TextBlock Text="Fast instancing"/><TextBlock Style="{StaticResource Desc}" Text="Skips a re-check. Leave off until a run proves it holds on this model."/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkMergeParts" Style="{StaticResource Switch}" ToolTip="An element built from many fragments (a seat of a thousand parts) is written as ONE shape instead of one placed copy per fragment, and every identical element reuses that shape. Viewers then place one copy per element, not millions of tiny ones.&#x0a;&#x0a;Applies to elements with more than 16 parts. Elements with fewer keep per-part instancing.&#x0a;&#x0a;Needs instancing to be on.">
                      <StackPanel><TextBlock Text="Merge multi-part elements"/><TextBlock Style="{StaticResource Desc}" Text="One placed copy per element, not per fragment."/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkSkipEmptyProps" Style="{StaticResource Switch}" ToolTip="Do not write properties whose value is blank. Each one costs a full entity carrying a single space, and blanks also stop otherwise-identical property sets from being shared.">
                      <StackPanel><TextBlock Text="Skip empty property values"/><TextBlock Style="{StaticResource Desc}" Text="Blank values are not written."/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkShareTypeProps" Style="{StaticResource Switch}" ToolTip="Put the properties that are the same for every element of a type onto the IfcElementType, and write only what differs on each element: the standard IFC arrangement (type Psets shared, occurrence Psets override). IFC4, and needs a Type role.&#x0a;&#x0a;Off by default because it moves data to where a simpler IFC reader may not look. The report says how many elements it could not express exactly; zero means the export is faithful.">
                      <StackPanel><TextBlock Text="Share type-level properties"/><TextBlock Style="{StaticResource Desc}" Text="Moves data to the type. A simpler reader may not look there."/></StackPanel>
                    </CheckBox>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <CheckBox x:Name="ChkMinSize" Style="{StaticResource Switch}" ToolTip="Leave out parts below this size: washers, fasteners, screen-only detail. These are a large share of the triangle count on plant models and add nothing to a coordination deliverable.&#x0a;&#x0a;This REMOVES objects rather than simplifying them, so everything dropped is counted in the report.">
                        <StackPanel><TextBlock Text="Skip geometry smaller than"/><TextBlock Style="{StaticResource Desc}" Text="Removes small objects from the file."/></StackPanel>
                      </CheckBox>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                        <TextBox x:Name="TxtMinSizeMm" Text="5" Style="{StaticResource InlineNum}"/>
                        <TextBlock Text="mm" Width="22" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <CheckBox x:Name="ChkSimplify" Style="{StaticResource Switch}" ToolTip="Reduce heavily tessellated objects before they are written: triangles are removed from flat and gently curved regions while no surface moves further than this distance. Each unique shape is simplified once and every copy of it reuses the result.&#x0a;&#x0a;Unlike 'Skip geometry smaller than' nothing is left out: every object is still there, with fewer triangles. Off by default because it changes the shapes; the report gives the triangle count before and after.">
                        <StackPanel><TextBlock Text="Simplify meshes within"/><TextBlock Style="{StaticResource Desc}" Text="Removes triangles from flat regions. Each unique shape is simplified once."/></StackPanel>
                      </CheckBox>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                        <TextBox x:Name="TxtSimplifyMm" Text="10" Style="{StaticResource InlineNum}"/>
                        <TextBlock Text="mm" Width="22" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <CheckBox x:Name="ChkSplit" Style="{StaticResource Switch}" ToolTip="Split the output into several files once it grows past this size.">
                        <StackPanel><TextBlock Text="Split files larger than"/><TextBlock Style="{StaticResource Desc}" Text="Rolls into name_001, name_002… each a complete IFC."/></StackPanel>
                      </CheckBox>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                        <TextBox x:Name="TxtSplitMb" Text="200" Style="{StaticResource InlineNum}"/>
                        <TextBlock Text="MB" Width="22" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource H3}" Text="CHECKS AND DIAGNOSTICS" Margin="0,6,0,10"/>
                    <CheckBox x:Name="ChkValidate" Style="{StaticResource Switch}" ToolTip="Check the written IFC for structural damage and for the mistakes this exporter can make: bad PredefinedType values, wrong attribute counts, dangling references.">
                      <StackPanel><TextBlock Text="Validate after writing"/><TextBlock Style="{StaticResource Desc}" Text="Checks the file for structural damage and exporter mistakes."/></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkProfile" Style="{StaticResource Switch}" ToolTip="Break down where the file size and the export time went, in the report. Adds a little overhead.">
                      <StackPanel><TextBlock Text="Size and time breakdown"/><TextBlock Style="{StaticResource Desc}" Text="Adds a timing and size section to the report."/></StackPanel>
                    </CheckBox>

                    <Button Style="{StaticResource LinkBtn}" Click="OnResetAdvanced" Margin="0,2,0,0"
                            ToolTip="Put every option in this panel back to its default. Scope, format and the other tabs are not touched.">
                      <TextBlock Text="↺ Reset advanced options"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ DATA ═══════════════ -->
        <TabItem x:Name="TabData">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" ToolTip="What data each element carries: property sets, materials, quantities, semantic roles and parameter renames.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_table}"/>
              <TextBlock Text="Data" Margin="6,0,0,0" VerticalAlignment="Center"/>
              <Ellipse x:Name="DotData" Style="{StaticResource TabDot}"/>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer Style="{StaticResource TabBody}">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_table}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="What to export"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipOpt}"><TextBlock Text="OPTIONAL"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Off is a legitimate choice"/>
                  <CheckBox x:Name="ChkProps" Style="{StaticResource Switch}" ToolTip="Write each element's property sets into the IFC.">
                    <StackPanel><TextBlock Text="Properties"/><TextBlock Style="{StaticResource Desc}" Text="All property sets ticked below"/></StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="ChkMaterials" Style="{StaticResource Switch}" Content="Materials and colours" ToolTip="Write material names and colours."/>
                  <CheckBox x:Name="ChkQuantities" Style="{StaticResource Switch}" ToolTip="Compute and write IfcElementQuantity base quantities.">
                    <StackPanel><TextBlock Text="Base quantities"/><TextBlock Style="{StaticResource Desc}" Text="Qto_*BaseQuantities: volume, area, length, width, height"/></StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="ChkAutoClassify" Style="{StaticResource Switch}" Margin="0,0,0,4" ToolTip="Elements no mapping rule covers get an IFC class from fixed rules instead of IfcBuildingElementProxy: the IFC class a model already states, the Revit category (Walls, Pipes, Structural Framing…), then whole words in family, type and element names. Your mapping rules always win, nothing is guessed when the evidence is ambiguous, and each element records the rule that decided in the BIMCamel_Classification property set.">
                    <StackPanel><TextBlock Text="Auto-classify unmapped elements"/><TextBlock Style="{StaticResource Desc}" Text="Fixed rules, no network: stated IFC class, Revit category, then whole words in names"/></StackPanel>
                  </CheckBox>
                  <Border Style="{StaticResource Divider}" Margin="0,6,0,12"/>
                  <TextBlock Style="{StaticResource H3}" Text="READ PROPERTIES FROM" Margin="0,0,0,10"/>
                  <ListBox x:Name="CmbPropSource" Style="{StaticResource RadioList}"
                           ToolTip="Which level of the Navisworks selection tree each element's properties come from.&#x0a;&#x0a;Navisworks exports geometry, but most authoring tools put the useful data on the object ABOVE the geometry: Revit's Element tab sits on the element node, SmartPlant 3D and E3D on the occurrence several levels up.&#x0a;&#x0a;Where the geometry and a parent both carry the same property, the geometry's value is kept.">
                    <ListBoxItem>
                      <StackPanel><TextBlock Text="Geometry only"/><TextBlock Style="{StaticResource Desc}" Text="Properties on the geometry node only. Misses Revit's Element tab."/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                      <StackPanel>
                        <TextBlock TextWrapping="Wrap"><Run Text="Geometry + parent object"/><Run Text="  RECOMMENDED FOR REVIT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeAutoTx}"/></TextBlock>
                        <TextBlock Style="{StaticResource Desc}" Text="Adds the nearest composite object's properties (Navisworks' Last Object). The geometry wins where both carry the same property."/>
                      </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                      <StackPanel><TextBlock Text="Geometry + all parents"/><TextBlock Style="{StaticResource Desc}" Text="Climbs to just below the file node. Needed for SmartPlant 3D and E3D."/></StackPanel>
                    </ListBoxItem>
                  </ListBox>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" Text="Re-run Smart setup after changing this so the list below sees the new categories."/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_layers}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Property sets"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipAuto}"><TextBlock Text="AUTO"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock x:Name="LblCatsSub" Style="{StaticResource Sub}" Text="Nothing scanned yet: every property set exports. Run Smart setup to list them."/>
                  <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                      <Button Style="{StaticResource LinkBtn}" Content="All" Click="OnCatsAll" Margin="0,0,10,0" ToolTip="Tick every property set shown."/>
                      <Button Style="{StaticResource LinkBtn}" Content="None" Click="OnCatsNone" ToolTip="Untick every property set shown."/>
                    </StackPanel>
                    <TextBox x:Name="TxtCatFilter" Tag="Search property sets" TextChanged="OnCatFilter" ToolTip="Show only the property sets whose name contains this text. All and None then act on the ones shown."/>
                  </DockPanel>
                  <ListBox x:Name="LstCategories" BorderThickness="0" Background="Transparent" MaxHeight="300"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ToolTip="Property sets to include. If you never scan, all are exported.">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0" Padding="2,6"><ContentPresenter/></Border>
                          </ControlTemplate>
                        </Setter.Value></Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/>
                          </CheckBox>
                          <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12" Margin="10,0,4,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="OnScanSelection"
                            ToolTip="Scan only the elements currently selected in Navisworks, whatever the export scope is set to. Useful when specific elements carry the property sets you care about but you are exporting something wider.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_find}" Margin="0,0,7,0"/><TextBlock Text="Scan selection instead"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="LblCatCount" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Every property set will be exported"/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- Semantic roles: WHICH property carries the type, level, material… -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_tune}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Semantic roles"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipAuto}"><TextBlock Text="AUTO"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Blank turns a role off. Element name is never guessed."/>
                  <StackPanel x:Name="RoleHost"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_columns}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Parameter mapping"/>
                    <Border Grid.Column="2" Style="{StaticResource ChipOpt}"><TextBlock Text="OPTIONAL"/></Border>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Rename a source property or move it into another pset"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource Btn}" Click="OnParamAdd" ToolTip="Add a mapping: source category and property, then the IFC property set and name it becomes.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_add}" Margin="0,0,7,0"/><TextBlock Text="Add mapping"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="OnParamImportCsv" ToolTip="Add mapping rows from a CSV file with the columns: source category, source property, target pset, target name. A header row is skipped. Edit the list in Excel and bring it back.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_read}" Margin="0,0,7,0"/><TextBlock Text="Import CSV…"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="OnParamExportCsv" ToolTip="Save these mapping rows as a CSV file, to edit in Excel or reuse on another project.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_save}" Margin="0,0,7,0"/><TextBlock Text="Export CSV…"/></StackPanel>
                    </Button>
                  </WrapPanel>
                  <ListBox x:Name="GridParams" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RuleCard}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SourceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Category"
                                    ToolTip="Source category. (any category) matches the property wherever it is."/>
                          <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding AvailableProps}" Text="{Binding SourceProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Source property"
                                    ToolTip="Source property to rename or move."/>
                          <ComboBox Grid.Row="2" IsEditable="True" ItemsSource="{Binding Psets}" Text="{Binding TargetPset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="To property set"
                                    ToolTip="The IFC property set it is written into."/>
                          <ComboBox Grid.Row="2" Grid.Column="2" IsEditable="True" ItemsSource="{Binding ParamNames}" Text="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="As name"
                                    ToolTip="The name it is written under."/>
                          <Button Grid.Column="3" Style="{StaticResource CloseBtn}" Margin="6,0,-4,0"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ MAPPING ═══════════════ -->
        <TabItem x:Name="TabMapping">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" ToolTip="Assign Navisworks sets and property values to IFC classes and classification codes. Smart setup proposes the rules; this tab is where you edit them.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_group}"/>
              <TextBlock Text="Mapping" Margin="6,0,0,0" VerticalAlignment="Center"/>
              <Ellipse x:Name="DotMapping" Style="{StaticResource TabDot}"/>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer Style="{StaticResource TabBody}">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_group}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Set rules"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Navisworks set → IFC class. The higher rule wins when an element is in two sets. Unmapped elements stay IfcBuildingElementProxy."/>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource Btn}" Click="OnMapAdd" ToolTip="Add a new set → class rule.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_add}" Margin="0,0,7,0"/><TextBlock Text="Add rule"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="OnPreviewMapping" ToolTip="Resolve the rules against the export scope without writing anything. The one-line result shows here; the full breakdown is under Pre-flight on the Export tab.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_tick}" Margin="0,0,7,0"/><TextBlock Text="Check these rules"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="OnMapClear" ToolTip="Remove every set rule.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_bin}" Margin="0,0,7,0"/><TextBlock Text="Clear all"/></StackPanel>
                    </Button>
                  </WrapPanel>
                  <TextBlock x:Name="LblMapSummary" Style="{StaticResource Sub}" Text="Not checked yet. Resolves the rules against your scope without writing anything."/>
                  <ListBox x:Name="GridMap" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RuleCard}" AllowDrop="True">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <DockPanel Margin="0,0,0,7">
                            <ContentControl DockPanel.Dock="Left" Style="{StaticResource Grip}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CloseBtn}" Margin="0,-3,-4,-3"/>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{Binding Number, StringFormat='RULE {0}'}"/>
                          </DockPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ComboBox ItemsSource="{Binding Sets}" Tag="Navisworks set…"
                                      SelectedItem="{Binding Set, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Saved selection set or search set."/>
                            <ComboBox Grid.Column="2" Style="{StaticResource MonoCombo}" ItemsSource="{Binding Classes}" Tag="IFC class"
                                      SelectedItem="{Binding IfcClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="IFC class to export the set's elements as."/>
                            <ComboBox Grid.Row="2" IsEditable="True" ItemsSource="{Binding PredefinedOptions}" Tag="PredefinedType"
                                      Text="{Binding Predefined, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="IFC PredefinedType for this class (optional). Pick from the values IFC4 defines for it, or type your own."/>
                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource MonoBox}" Tag="Classification code"
                                     Text="{Binding Classification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Classification code for every element in this set (optional), such as a Uniclass or OmniClass code. Overrides the Classification property role."/>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <!-- Rules by property value: the same IF/THEN as a search set, without having to
                   build and save one in Navisworks first. -->
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_filter}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Rules by property value"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Pick a class or code straight from a property, no search set needed. Only fills what set rules left empty. First match wins."/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource Btn}" Click="OnPropRuleAdd" ToolTip="Add a rule that picks a class by a property value.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_add}" Margin="0,0,7,0"/><TextBlock Text="Add rule"/></StackPanel>
                    </Button>
                  </WrapPanel>
                  <ListBox x:Name="GridPropRules" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RuleCard}" AllowDrop="True">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <DockPanel Margin="0,0,0,7">
                            <ContentControl DockPanel.Dock="Left" Style="{StaticResource Grip}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CloseBtn}" Margin="0,-3,-4,-3"/>
                            <TextBlock Style="{StaticResource CardLabel}" Text="IF"/>
                          </DockPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ComboBox ItemsSource="{Binding Categories}" Tag="Category"
                                      SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Property category, or any."/>
                            <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding AvailableProps}" Tag="Property"
                                      Text="{Binding Property, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Property to test."/>
                            <ComboBox Grid.Row="2" ItemsSource="{Binding Tests}"
                                      SelectedItem="{Binding Test, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="How the value is compared. Never case-sensitive."/>
                            <TextBox Grid.Row="2" Grid.Column="2" Tag="Value"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Value to compare with."/>
                            <TextBlock Grid.Row="3" Style="{StaticResource CardLabel}" Text="THEN" Margin="0,10,0,7"/>
                            <ComboBox Grid.Row="4" Style="{StaticResource MonoCombo}" ItemsSource="{Binding Classes}" Tag="IFC class"
                                      SelectedItem="{Binding IfcClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="IFC class to export matching elements as."/>
                            <ComboBox Grid.Row="4" Grid.Column="2" IsEditable="True" ItemsSource="{Binding PredefinedOptions}" Tag="PredefinedType"
                                      Text="{Binding Predefined, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="PredefinedType (optional)."/>
                            <TextBox Grid.Row="6" Style="{StaticResource MonoBox}" Tag="Classification code"
                                     Text="{Binding Classification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Classification code (optional), such as a Uniclass code."/>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_link}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Classification and groups"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="System name"/>
                    <TextBox x:Name="TxtClassSystem" Tag="e.g. Uniclass 2015" ToolTip="Name of the classification system the codes in the rules belong to, such as “Uniclass 2015” or “OmniClass”. Written as IfcClassification.Name; blank falls back to a generic source label."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Source"/>
                    <TextBox x:Name="TxtClassSource" Tag="Publisher" ToolTip="Who publishes the classification, such as “NBS” for Uniclass. Written as IfcClassification.Source, which IFC2x3 makes mandatory; leave it blank and the system name is used. It is never this exporter’s name: a file claiming BIMCamel publishes Uniclass is a false statement in a deliverable."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Edition"/>
                    <TextBox x:Name="TxtClassEdition" ToolTip="Which edition, such as “2015”. Uniclass 2015 and Uniclass 1997 are different tables with overlapping codes, so this is what tells the other end whether a code means what they think it means. Mandatory in IFC2x3, where an unstated edition is written as “-”."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Edition date"/>
                    <TextBox x:Name="TxtClassEditionDate" Tag="YYYY-MM-DD" ToolTip="The edition’s publication date. Anything that is not a plain calendar date is left out rather than guessed at: a malformed date makes a strict reader reject the file, where an absent optional one is perfectly valid."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Location"/>
                    <TextBox x:Name="TxtClassLocation" Tag="URL" ToolTip="Where the classification is published. IFC4 only: IfcClassification gained Location in IFC4, so on IFC2x3 this is not written."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Also export sets as"/>
                    <ComboBox x:Name="CmbGroups" ToolTip="Emit each mapped Navisworks set as an IFC group, with IfcRelAssignsToGroup membership. Use IfcSystem for MEP systems and IfcZone for spatial zones."/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" Text="Codes from a rule override the Classification role. IfcSystem suits MEP systems, IfcZone spatial zones."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ PROJECT ═══════════════ -->
        <TabItem x:Name="TabCoords">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" ToolTip="What the model is called and where it sits: project, site, building and storey names, the base point and real-world georeferencing.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_model}"/>
              <TextBlock Text="Project" Margin="6,0,0,0" VerticalAlignment="Center"/>
              <Ellipse x:Name="DotCoords" Style="{StaticResource TabDot}"/>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer Style="{StaticResource TabBody}">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_model}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Project and spatial structure"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Project name"/>
                    <TextBox x:Name="TxtProject" Text="" ToolTip="Name written to the IfcProject. Leave blank to use the Navisworks file's name, which is what most receivers expect to see."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Site name"/>
                    <TextBox x:Name="TxtSite" Text="Site" ToolTip="Name written to the IfcSite."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Building name"/>
                    <TextBox x:Name="TxtBuilding" Text="Building" ToolTip="Name written to the IfcBuilding."/>
                  </DockPanel>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L104}" Text="Fallback storey"/>
                    <TextBox x:Name="TxtStorey" Text="Storey" ToolTip="Storey for elements whose Level role is empty."/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,10" Text="A blank project name uses the Navisworks file name. Storeys come from the Level role on the Data tab."/>
                  <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="OnCheckStoreys"
                            ToolTip="List the storeys the export will create, with each one's elevation and element count. Runs the full check if it has not run yet.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_layers}" Margin="0,0,7,0"/><TextBlock Text="Check storeys"/></StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Sub}" Margin="0" VerticalAlignment="Center" Text="Lists the storeys the export will create."/>
                  </DockPanel>
                  <Border x:Name="StoreysBox" Style="{StaticResource Console}" Margin="0,10,0,0" MaxHeight="220" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtStoreys" LineHeight="17" Text="Run Smart setup or Run full check (Export tab) to list them."/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_ruler}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Base point"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <TextBlock Style="{StaticResource Sub}" Text="How large the stored coordinates are. It never moves the model."/>
                  <ComboBox x:Name="CmbBasePoint" ToolTip="Where the IFC local origin sits. This only affects how large the stored coordinates are: the placement chain puts the model back at its world position either way. Real-world georeferencing is set below."/>
                  <Grid x:Name="CoordRow" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Custom base point: easting, northing and elevation in metres.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtE" Grid.Column="0" Style="{StaticResource MonoBox}" Tag="E (m)"/>
                    <TextBox x:Name="TxtN" Grid.Column="2" Style="{StaticResource MonoBox}" Tag="N (m)"/>
                    <TextBox x:Name="TxtElev" Grid.Column="4" Style="{StaticResource MonoBox}" Tag="Elevation (m)"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Origin written:"/>
                    <Run x:Name="LblPreview" FontFamily="Consolas" Foreground="{DynamicResource Text}" Text="—"/>
                  </TextBlock>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource CardHead}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource HeadIco}" Tag="{StaticResource G_sphere}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="Georeferencing"/>
                  </Grid>
                  <Border Style="{StaticResource Divider}"/>
                  <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource L96}" Text="Write"/>
                    <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Text="IFC4 only"/>
                    <CheckBox x:Name="ChkGeoref" Style="{StaticResource Switch}" Margin="0" Content="IfcMapConversion"
                              ToolTip="Record where the model sits in a real-world projected CRS. IFC4 only. Written only when you supply a CRS or a survey point below: an empty map conversion is worse than none."/>
                  </DockPanel>
                  <StackPanel x:Name="GeorefRow">
                    <DockPanel Style="{StaticResource FormRow}">
                      <TextBlock Style="{StaticResource L96}" Text="CRS"/>
                      <TextBox x:Name="TxtCrs" Style="{StaticResource MonoBox}" Tag="EPSG:27700" ToolTip="The projected coordinate reference system, such as EPSG:27700."/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                      <TextBlock Style="{StaticResource L96}" Text="Eastings"/>
                      <TextBox x:Name="TxtSurveyE" Style="{StaticResource MonoBox}" ToolTip="The model origin's easting in the CRS, in metres."/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                      <TextBlock Style="{StaticResource L96}" Text="Northings"/>
                      <TextBox x:Name="TxtSurveyN" Style="{StaticResource MonoBox}" ToolTip="The model origin's northing in the CRS, in metres."/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                      <TextBlock Style="{StaticResource L96}" Text="Elevation"/>
                      <TextBox x:Name="TxtSurveyElev" Style="{StaticResource MonoBox}" ToolTip="The model origin's elevation in metres."/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                      <TextBlock Style="{StaticResource L96}" Text="Grid rotation"/>
                      <TextBox x:Name="TxtRot" Style="{StaticResource MonoBox}" ToolTip="Rotation from project north to grid north, in degrees."/>
                    </DockPanel>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,10" Text="Written only when you provide data. An empty map conversion is worse than none."/>
                  <Button Style="{StaticResource Btn}" HorizontalAlignment="Left" Click="OnFederationReport"
                          ToolTip="List every loaded model's origin, rotation and units below, and flag any disagreement, before you export.">
                    <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_find}" Margin="0,0,7,0"/><TextBlock Text="Check federated model origins"/></StackPanel>
                  </Button>
                  <Border x:Name="CoordReportBox" Style="{StaticResource Console}" Margin="0,10,0,0" MaxHeight="220" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="TxtCoordReport" TextWrapping="NoWrap" LineHeight="17" Text=""/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ REPORT ═══════════════ -->
        <TabItem x:Name="TabReport">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" ToolTip="What the last export wrote: files and sizes, what did not reach the IFC and why, timing and validation.">
              <ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_report}"/>
              <TextBlock x:Name="LblReportTab" Text="Report" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer Style="{StaticResource TabBody}">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="Copy" Click="OnCopyReport" ToolTip="Copy the report text to the clipboard."/>
                    <TextBlock x:Name="LblReportHead" Style="{StaticResource H3}" Text="REPORT"/>
                  </DockPanel>
                  <Border Style="{StaticResource Console}" Margin="-12,0" CornerRadius="0" Padding="12,10">
                    <Grid>
                      <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtReport" TextWrapping="NoWrap" LineHeight="17" Text=""/>
                      </ScrollViewer>
                      <TextBlock TextWrapping="Wrap" LineHeight="17"
                                 Text="Nothing has been exported yet. After an export this shows the files and sizes, what did not reach the IFC and why, mapped and proxy counts, storeys, timing and the validation result.">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=TxtReport}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                  <!-- The output stays one click away after the export. -->
                  <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource Btn}" Click="OnCopyReport" Margin="0,0,7,6" ToolTip="Copy the report text to the clipboard.">
                      <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Ico}" Tag="{StaticResource G_copy}" Margin="0,0,7,0"/><TextBlock Text="Copy"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnOpenFile" Style="{StaticResource Btn}" Margin="0,0,7,6" Content="Open file" Click="OnOpenOutput" IsEnabled="False"
                            ToolTip="Open the exported IFC in its default viewer. Not offered when the export wrote several files."/>
                    <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn}" Margin="0,0,7,6" Content="Open folder" Click="OnOpenOutputFolder" IsEnabled="False"
                            ToolTip="Show the exported file(s) in Explorer."/>
                    <Button x:Name="BtnSaveReport" Style="{StaticResource Btn}" Margin="0,0,7,6" Content="Save report…" Click="OnSaveReport" IsEnabled="False"
                            ToolTip="Save this report as a text file, to keep a record of the export."/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <!-- Footer: progress line, status, Stop and Export. Stop lives out here, not on a tab,
           because BeginBusy disables the tabs; a Stop inside them would be greyed out during
           exactly the work it exists to stop. -->
      <Border Grid.Row="2" Background="{DynamicResource Nav}">
        <StackPanel>
          <Border Height="3" Background="{DynamicResource Track}">
            <ProgressBar x:Name="Progress" Visibility="Collapsed"/>
          </Border>
          <Grid Margin="12,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LblStatus" Text="Ready. Nothing written yet." FontSize="12" Foreground="{DynamicResource Muted}" LineHeight="16"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel" Grid.Column="1" Style="{StaticResource Btn}" Margin="0,0,8,0"
                    Content="Stop" Click="OnCancelWork" Visibility="Collapsed"
                    ToolTip="Stop the scan. Nothing has been written to disk; settings already filled in are kept, and you can run it again."/>
            <!-- Says what the click will do (schema, form, how many files) and follows those settings. -->
            <Button x:Name="BtnExport" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Click="OnExport" ToolTip="Export to IFC with the current settings (you choose where to save).">
              <TextBlock x:Name="LblExportBtn" Text="Export IFC"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
